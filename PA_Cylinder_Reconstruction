#!/usr/bin/env python3
"""
PA_cylindrical_reconstruction.py
================================
Reconstruct a connected, capped 3-D pulmonary artery (PA) surface from a
*trimmed* VTK centerline (.vtp), without using an existing 3-D vessel surface.

DESIGN
------
  (1) Interpret connected 1-D centerline edges as a rooted graph (IsInlet).
      Collapse repeated edges but do NOT invent edges between nearby branches.
  (2) Split the tree at bifurcations and ends. Each directed graph branch is
      independently lofted through circles oriented perpendicular to its local
      tangent; at a junction, each outgoing branch gets its own oriented ring.
  (3) Treat each successive ring pair as a closed tapered tube and combine
      their NEGATIVE-INSIDE implicit fields by pointwise minimum (union). This
      produces a true geometric UNION,
      unlike Delaunay3D on all appended rings, which can bridge empty space.
  (4) Extract a single union surface with FlyingEdges, attach provisional
      ModelFaceID + SimVascular .facenames, and save extensive diagnostics.

IMPORTANT:
- This is an INITIAL reconstruction approach. The implicit union is voxelized:
  terminal caps are nearly planar, not mathematically exact planes. Review
  cap-to-wall labels and topology before Gmsh / SimVascular meshing.
- Radius values (including clamped values) are in the units of the source VTP.
- Delaunay3D is intentionally NOT used globally. The ring loft is a QUAD-strip
  surface triangulation; disconnected tubes only meet during the implicit union.
- A *trimmed* centerline is required. The script does not choose which anatomical
  branches should be discarded, and does not perform clot subtraction.

Run:
  python PA_cylindrical_reconstruction.py
  python PA_cylindrical_reconstruction.py --input /path/to/trimmed.vtp \
      --output-dir /path/to/PA_cylindrical_output --spacing 0.7

Requirements: numpy, scipy, vtk. Python 3.9+ (including 3.12).
"""

from __future__ import annotations
import argparse
import csv
import heapq
import json
import math
import os
from pathlib import Path
from collections import Counter, defaultdict
from dataclasses import dataclass

import numpy as np
from scipy import ndimage
import vtk
from vtk.util.numpy_support import numpy_to_vtk, numpy_to_vtkIdTypeArray, vtk_to_numpy

# ======================== USER CONFIGURATION ================================
CENTERLINE_VTP = r"JL_Centerline_Trimmed.vtp"  # <--- CHANGE TO YOUR TRIMMED VTP
OUTPUT_DIR = r"PA_cylindrical_reconstruction"

RADIUS_ARRAY_CANDIDATES = ("Radius", "MaximumInscribedSphereRadius")
INLET_ARRAY = "IsInlet"
OUTLET_ARRAY = "IsOutlet"
SIDEDNESS_ARRAY = "Sidedness"  # vtkStringArray: Left, Right, other/null

CIRCLE_RESOLUTION = 40
MAX_RING_STEP = 2.0               # longest axial spacing between neighboring rings
RING_STEP_RADIUS_FACTOR = 0.85   # also restrict ring step relative to radius
MIN_CENTERLINE_STEP = 1.0e-7
RADIUS_FLOOR_ABSOLUTE = 0.35     # use 0 to disable; identical units to VTP
RADIUS_FLOOR_MEDIAN_FACTOR = 0.0 # optionally e.g. 0.1, applied in addition

# An implicit UNION makes branch intersections well-defined and avoids the
# need to choose a triangulation spanning an entire group of circles.
VOXEL_SPACING = 0.65
MAX_GRID_VOXELS = 50_000_000      # safety cap, auto-coarsen if too large
AUTO_COARSEN_GRID = True
SURFACE_BLUR_SIGMA_VOXELS = 0.45  # 0 = no smoothing of signed distance field
GRID_PADDING_RADII = 1.5
GRID_PADDING_VOXELS = 5

# Label exposed terminal cap triangles by distance to their original ring
# plane AND agreement between outward terminal normal and surface normal.
CAP_PLANE_TOL_VOXELS = 1.9
CAP_PLANE_TOL_RADIUS_FACTOR = 0.12
CAP_MAX_RADIAL_FACTOR = 1.25
CAP_NORMAL_ALIGNMENT_MIN = 0.52

# Diagnostic output; unmerged tubes are NOT suitable as a CFD boundary.
WRITE_UNMERGED_TUBES = True
WRITE_RING_DEBUG = True
WRITE_UNION_DISTANCE_FIELD_VTI = False  # potentially enormous
EXTRACT_SINGLE_REGION_ONLY = False     # manual override: keep largest even if not tiny
AUTO_REMOVE_TINY_UNION_ISLANDS = True  # prune only extremely small voxel islands
TINY_ISLAND_MAX_FRACTION_OF_MAIN = 0.004
TINY_ISLAND_MAX_TOTAL_FRACTION = 0.02

# If centerline has cycles (common in noisy/overlapping networks), the rooted
# shortest-path spanning tree is used. All discarded graph links are reported.
ALLOW_CYCLES_WITH_SPANNING_TREE = True
