for i, tool_path in enumerate(TOOL_VTPS):

    print(
        f"[{i+1}/{len(TOOL_VTPS)}] "
        f"{tool_path}"
    )

    tool_pv = load_surface(tool_path)
    tool_tm = repair(pv_to_tm(tool_pv))
    del tool_pv

    mf_tool = tm_to_manifold(tool_tm)
    del tool_tm  # release before the boolean allocates

    mf_base = mf_base - mf_tool
    del mf_tool

    if mf_base.is_empty():

        sys.exit(
            f"Boolean subtraction failed "
            f"at tool #{i+1}"
        )

    # ----------------------------------------------------------
    # Manifold-level single-region check after each boolean.
    # Cheap: stays inside manifold3d, no numpy or trimesh round-
    # trip.  Eliminates stray disconnected shells early so they
    # don't pollute subsequent booleans or the trimesh repair.
    # ----------------------------------------------------------
    print(f"  Enforcing single region (manifold level) after subtraction #{i+1}...")
    mf_base = enforce_single_region_manifold(mf_base, label=f"post-boolean-{i+1}")

    # ----------------------------------------------------------
    # Trimesh repair round-trip to fix T-junctions / slivers
    # left by manifold3d at cut seams.
    # ----------------------------------------------------------
    print(f"  Repairing result after subtraction #{i+1}...")

    tm_intermediate = repair(manifold_to_tm(mf_base))

    if SAVE_EACH_BOOLEAN_STAGE:
        DIAGNOSTIC_DIR.mkdir(parents=True, exist_ok=True)
        stage_path = DIAGNOSTIC_DIR / f"boolean_after_tool_{i+1:02d}.vtp"
        tm_to_pv(tm_intermediate).save(str(stage_path))
        print(f"  Saved intermediate boolean result: {stage_path}")

    mf_base = tm_to_manifold(tm_intermediate)
    del tm_intermediate

# ============================================================
# FINAL CONVERSION + REPAIR
# ============================================================

print("Converting boolean result...")

tm_result = manifold_to_tm(mf_base)
del mf_base

# ============================================================
# FINAL SINGLE-REGION ENFORCEMENT  (trimesh level)
#
# This is the definitive check.  By this point the manifold-
# level checks have already pruned stray shells, so in the
# normal case this is a no-op.  It exists as a hard safety net
# because the trimesh repair steps (fill_holes, fix_normals)
# can occasionally re-introduce disconnected micro-patches.
#
# We use trimesh.split() rather than largest-component picking
# so we can report exactly what was discarded.
# ============================================================

print("Enforcing single connected region (final, trimesh level)...")

region_components = tm_result.split(only_watertight=False)

if len(region_components) > 1:

    sizes = [len(c.faces) for c in region_components]
    best_idx = int(np.argmax(sizes))
    tm_result = region_components[best_idx]
    discarded = sum(sizes) - sizes[best_idx]

    print(
        f"  WARNING: {len(region_components)} disconnected regions found after repair.\n"
        f"  Keeping largest region ({sizes[best_idx]} faces); "
        f"discarding {discarded} faces across "
        f"{len(region_components) - 1} smaller region(s).\n"
        f"  If the discarded count is large, inspect the boolean inputs for gaps or overlaps."
    )

else:
    print(f"  Single region confirmed ({len(tm_result.faces)} faces) — OK")

del region_components

tm_result = repair(tm_result)

print("Assessing PRIMARY closed Boolean surface...")
report_surface_discretization(tm_result, label="primary closed boolean")

if WRITE_DEBUG_SURFACES:
    print(f"Writing pre-remesh diagnostic surface: {DEBUG_PRE_REMESH_VTP}")
    tm_to_pv(tm_result).save(DEBUG_PRE_REMESH_VTP)

if GENERATE_OPEN_WALL_SECONDARY and not REBUILD_CAPS_FROM_SCRATCH:
    raise RuntimeError(
        "Secondary open-wall extraction requires "
        "REBUILD_CAPS_FROM_SCRATCH=True."
    )

# Write labeled PRIMARY closed output before any optional cap removal.
# This checkpoint is preserved regardless of subsequent remeshing outcomes.
DIAGNOSTIC_DIR.mkdir(parents=True, exist_ok=True)
print(f"Writing PRIMARY labeled closed subtraction result: {CLOSED_BOOLEAN_OUTPUT_VTP}")
_write_cap_reference(caps)
try:
    write_closed_boolean_with_facenames(tm_result, caps, target_remesh_edge)
except Exception as exc:
    # Never lose the successfully subtracted geometry due to a labeling bug.
    # Write a clearly identified wall-only fallback with matching .facenames.
    _status("closed_cap_assignment", (
        f"Cap face labeling failed: {type(exc).__name__}: {exc}. "
        "Saving closed geometry with wall-only labels for inspection."),
        severity="error")
    traceback.print_exc()
    source_names = read_facenames(OLD_FACENAMES)
    wall_items = [(fid, nm) for fid, nm in source_names.items()
                  if "wall" in nm.lower()]
    fallback_wall_id, fallback_wall_name = (
        wall_items[0] if len(wall_items) == 1
        else (max(source_names, default=0) + 1, "wall"))
    fallback_poly = tm_to_pv(tm_result)
    fallback_poly.cell_data["ModelFaceID"] = np.full(
        fallback_poly.n_cells, fallback_wall_id, dtype=np.int32)
    fallback_poly.save(CLOSED_BOOLEAN_OUTPUT_VTP)
    write_facenames(CLOSED_BOOLEAN_OUTPUT_FACENAMES,
                    {fallback_wall_id: fallback_wall_name})
    PIPELINE_REPORT["closed_cap_labels"] = {
        "status": "FALLBACK_WALL_ONLY", "exception": repr(exc),
        "warning": "Closed mesh is saved but cap labels are NOT assigned",
    }
_status("boolean_complete", (
    f"Saved PRIMARY closed result: {CLOSED_BOOLEAN_OUTPUT_VTP}; "
    f"facenames: {CLOSED_BOOLEAN_OUTPUT_FACENAMES}; "
    f"cap references: {CAP_REFERENCE_CSV}"))

# Intermediate and final outcomes are recorded independently.
last_good_wall = None
pre_remesh_wall = None
final_boundary = None
open_surface_exported = False

if GENERATE_OPEN_WALL_SECONDARY:
    try:
        print("Removing ALL legacy cap triangles...")
        tm_wall = strip_all_caps(tm_result, caps, target_remesh_edge)
        del tm_result
        _save_cap_removal_table()

        # Export immediately, EVEN IF ITS OPENINGS ARE NOT SIMPLE LOOPS.
        # Output is useful for manual repair; not necessarily SV-ready.
        print(f"Saving provisional open wall: {OUTPUT_VTP}")
        _save_open_candidate(tm_wall)
        open_surface_exported = True
        pre_remesh_wall = tm_wall

        if WRITE_DEBUG_SURFACES:
            tm_to_pv(tm_wall).save(DEBUG_OPEN_WALL_VTP)

        before = boundary_diagnostics(tm_wall, caps, "post_cap_removal", export=DIAGNOSTICS_ENABLED)
        unremoved_caps = [r["name"] for r in CAP_REMOVAL_RECORDS if r.get("status") != "REMOVED"]
        if unremoved_caps:
            # Topology can look normal even when a legacy cap was left in place.
            # Such an output must never be advertised as SimVascular-ready.
            before["caps_not_removed"] = unremoved_caps
            before["safe_to_treat_as_clean_open_surface"] = False
            _status("cap_removal", f"Failed to remove {len(unremoved_caps)} cap(s): "
                    + ", ".join(unremoved_caps[:12])
                    + (" ..." if len(unremoved_caps) > 12 else ""), severity="warning")
            if DIAGNOSTICS_ENABLED:
                (DIAGNOSTIC_DIR / "post_cap_removal" / "boundary_summary.json").write_text(
                    json.dumps(before, indent=2), encoding="utf-8")
        PIPELINE_REPORT["post_cap_removal"] = before
        _save_pipeline_report()
        _status("cap_removal", "Saved provisional open wall and cap-removal diagnostics"
                + (" (boundary needs manual repair)" if not before["safe_to_treat_as_clean_open_surface"] else ""),
                severity="warning" if not before["safe_to_treat_as_clean_open_surface"] else "info")

        if not before["safe_to_treat_as_clean_open_surface"] and not TRY_REMESH_ON_INVALID_BOUNDARY:
            print("\nSkipping ACVD remeshing: existing boundary is not made of simple, independent loops.")
            print("Attempting remesh here could merge or distort multiple openings.")
            final_boundary = before
        else:
            if ENABLE_UNIFORM_REMESH:
                print("Uniformly remeshing OPEN wall surface...")
                try:
                    remeshed = uniform_remesh_open_wall(tm_wall, target_remesh_edge)
                    if WRITE_DEBUG_SURFACES:
                        tm_to_pv(remeshed).save(DEBUG_REMESHED_OPEN_WALL_VTP)
                    after = boundary_diagnostics(remeshed, caps, "post_remesh", export=DIAGNOSTICS_ENABLED)
                    PIPELINE_REPORT["post_remesh"] = after
                    _save_pipeline_report()

                    if after["safe_to_treat_as_clean_open_surface"] and not unremoved_caps:
                        tm_wall = remeshed
                        _save_open_candidate(tm_wall)
                        final_boundary = after
                        _status("remesh", "ACVD remeshed surface validated; saved as final OPEN VTP")
                    else:
                        # Never overwrite provisional open mesh with a topology-worse
                        # remesh. Store it separately for visual investigation.
                        probe_path = DIAGNOSTIC_DIR / "remeshed_unvalidated.vtp"
                        tm_to_pv(remeshed).save(str(probe_path))
                        final_boundary = before
                        _status("remesh", f"ACVD output invalid. Kept pre-remesh open VTP; candidate saved to {probe_path}",
                                severity="warning")
                except Exception as exc:
                    final_boundary = before
                    _status("remesh", f"ACVD failed ({type(exc).__name__}: {exc}). Pre-remesh open VTP preserved.",
                            severity="warning")
                    traceback.print_exc()
            else:
                final_boundary = before
                print("Uniform remeshing disabled; using provisional open wall.")

    except Exception as exc:
        # The subtraction and cap reference are already safe on disk.
        # Keep a diagnostic of the exception rather than masking it.
        _status("cap_pipeline", f"{type(exc).__name__}: {exc}; closed Boolean result preserved",
                severity="error")
        traceback.print_exc()
        # If partial cap removal failed before returning, the last intact Boolean
        # still exists as CLOSED_BOOLEAN_OUTPUT_VTP. Do not mislabel it as open.
        if not open_surface_exported:
            print("  No reliable open-wall extraction was available. Use the saved closed Boolean VTP.")

    _save_cap_removal_table()
else:
    print("Secondary open-wall extraction disabled; PRIMARY closed VTP is saved.")

if not GENERATE_OPEN_WALL_SECONDARY:
    labels = PIPELINE_REPORT.get("closed_cap_labels", {})
    PIPELINE_REPORT["status"] = (
        "closed_primary_cap_labels_failed" if labels.get("status") == "FALLBACK_WALL_ONLY"
        else "closed_primary_requires_label_review" if (labels.get("missing_or_ambiguous_caps") or labels.get("partially_matched_caps"))
        else "closed_primary_labeled"
    )
    print("\nPRIMARY output: labeled closed Boolean surface.")
elif final_boundary is not None and final_boundary["safe_to_treat_as_clean_open_surface"]:
    PIPELINE_REPORT["status"] = "closed_primary_and_open_wall_boundary_validated"
    print("\nPASS: OPEN wall has the expected number of simple boundary loops.")
    print("  NOTE: 3-D self-intersections are not proven absent; verify before meshing.")
else:
    PIPELINE_REPORT["status"] = "closed_primary_and_partial_open_output"
    print("\nWARNING: Closed primary saved; OPEN wall requires manual repair/validation.")

_save_pipeline_report()
print("\n============================================")
print("SAVED RESULTS")
print("============================================")
print("  PRIMARY closed model     :", CLOSED_BOOLEAN_OUTPUT_VTP)
print("  PRIMARY closed facenames :", CLOSED_BOOLEAN_OUTPUT_FACENAMES)
print("  Closed cap assignments   :", DIAGNOSTIC_DIR / "closed_boolean_cap_assignment.csv")
if open_surface_exported:
    print("  Best available OPEN wall  :", OUTPUT_VTP)
    print("  OPEN wall facenames       :", OUTPUT_FACENAMES)
print("  Original cap references  :", CAP_REFERENCE_CSV)
print("  Diagnostics               :", DIAGNOSTIC_DIR.resolve())
print("  Pipeline status           :", PIPELINE_REPORT["status"])
if GENERATE_OPEN_WALL_SECONDARY:
    print("\nFor degree-4 openings, inspect post_cap_removal/broken_boundary_vertices.csv")
    print("and .vtp, and boundary_components.csv.")
print("Geometric cap labels do not certify a watertight, intersection-free surface.")
