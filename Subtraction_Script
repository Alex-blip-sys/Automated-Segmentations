def pv_to_tm(pv_mesh):

    tri = pv_mesh.triangulate()

    verts = np.array(tri.points)

    faces = tri.faces.reshape(-1, 4)[:, 1:]

    return trimesh.Trimesh(
        vertices=verts,
        faces=faces,
        process=False,
    )


def tm_to_manifold(tm):
    """Convert a Trimesh mesh to manifold3d using contiguous arrays.

    manifold3d's Python bindings expect C-contiguous numeric arrays.
    Explicitly creating them here avoids dtype/stride issues that can
    otherwise appear with newer NumPy / nanobind builds on Python 3.12.
    """

    vertices = np.ascontiguousarray(tm.vertices, dtype=np.float32)
    faces = np.ascontiguousarray(tm.faces, dtype=np.uint32)

    return Manifold(
        ManifoldMesh(
            vert_properties=vertices,
            tri_verts=faces,
        )
    )


def manifold_to_tm(mf):
    """Convert manifold3d output back to Trimesh with owned NumPy arrays."""

    m = mf.to_mesh()

    # copy=True is intentional: nanobind may expose views whose lifetime
    # is tied to the manifold mesh object.  Owning the arrays here is safer
    # across current Python 3.12 / manifold3d releases.
    vertices = np.array(m.vert_properties, dtype=np.float64, copy=True)
    faces = np.array(m.tri_verts, dtype=np.int64, copy=True)

    return trimesh.Trimesh(
        vertices=vertices,
        faces=faces,
        process=False,
    )


def tm_to_pv(tm):

    n = len(tm.faces)

    faces = np.hstack([
        np.full((n, 1), 3, dtype=np.int64),
        np.asarray(tm.faces, dtype=np.int64)
    ]).ravel()

    points = np.asarray(tm.vertices, dtype=np.float64)
    return pv.PolyData(points, faces)


# ============================================================
# VECTORIZED NON-MANIFOLD FACE STRIPPING
#
# Replaces the original Python-loop _strip_nonmanifold_faces.
# For a mesh with F faces, the old loop visited 3*F Python
# iterations per iteration of the outer loop.  At 10-20x mesh
# scale (millions of faces) that becomes seconds per pass.
#
# Strategy: encode each undirected edge as a single uint64
#   key = min_v * (max_vertex_index + 1) + max_v
# then use np.unique(..., return_counts=True) to count edge
# valence in one vectorised call.  Edge-to-face membership is
# resolved with another unique call rather than a Python dict,
# cutting both time and peak memory.
# ============================================================

def _strip_nonmanifold_faces_vectorized(tm):
    """
    Iteratively remove faces that own a non-manifold edge
    (valence > 2) using fully vectorised numpy operations.

    Peak extra memory: ~5 * F * 8 bytes (three edge columns +
    face indices + counts) — a small constant factor over the
    mesh itself, so it scales to large meshes without OOM.
    """

    for iteration in range(10):  # safety cap

        faces = tm.faces                         # (F, 3)  int32/64
        nf = len(faces)

        # -------------------------------------------------
        # Build one sorted edge per face-edge slot.
        # Columns: [min_v, max_v] for each of the 3 edges.
        # Shape: (3*F, 2)
        # -------------------------------------------------
        e0 = np.stack([faces[:, 0], faces[:, 1]], axis=1)
        e1 = np.stack([faces[:, 1], faces[:, 2]], axis=1)
        e2 = np.stack([faces[:, 2], faces[:, 0]], axis=1)

        all_edges = np.concatenate([e0, e1, e2], axis=0)   # (3F, 2)
        all_edges.sort(axis=1)                              # sort each row in-place

        # face index for each edge slot: [0..F-1, 0..F-1, 0..F-1]
        face_of_edge = np.tile(np.arange(nf, dtype=np.int64), 3)  # (3F,)

        # -------------------------------------------------
        # Encode edges as uint64 scalars for fast unique.
        # Using int64 arithmetic avoids overflow for meshes
        # up to ~3 billion vertices (safe for any real case).
        # -------------------------------------------------
        stride = int(all_edges.max()) + 1
        edge_keys = all_edges[:, 0].astype(np.int64) * stride + all_edges[:, 1].astype(np.int64)

        # unique edge keys + where each slot maps to in the unique list
        unique_keys, inv_idx, counts = np.unique(
            edge_keys, return_inverse=True, return_counts=True
        )

        # valence of the edge that each slot belongs to
        slot_valence = counts[inv_idx]                       # (3F,)

        # slots whose edge is non-manifold (valence > 2)
        bad_slots = slot_valence > 2

        if not bad_slots.any():
            break

        n_bad_edges = int((counts > 2).sum())
        print(
            f"  [repair] iteration {iteration + 1}: "
            f"removing {n_bad_edges} non-manifold edges "
            f"(vectorised)"
        )

        # faces that own at least one bad slot
        bad_face_mask = np.zeros(nf, dtype=bool)
        bad_face_mask[face_of_edge[bad_slots]] = True

        if not bad_face_mask.any():
            break

        # rebuild mesh without bad faces
        tm = trimesh.Trimesh(
            vertices=tm.vertices,
            faces=faces[~bad_face_mask],
            process=False,
        )

        tm.remove_unreferenced_vertices()

        # release temporary arrays immediately
        del e0, e1, e2, all_edges, edge_keys
        del unique_keys, inv_idx, counts, slot_valence, bad_slots, face_of_edge, bad_face_mask

    return tm


# ============================================================
# SINGLE-REGION ENFORCEMENT
#
# After the boolean pipeline the mesh must contain exactly one
# connected region before it enters SimVascular meshing.
# Multiple disconnected shells cause:
#   - Duplicated facet / face-intersection errors in BL mesher
#   - Ambiguous ModelFaceID assignment
#   - Non-manifold junctions at boolean seams
#
# We enforce this at TWO points:
#   1. Inside repair(), on the trimesh level (existing step 8,
#      now kept but using the improved strip call above).
#   2. After the final boolean, on the manifold3d level, via
#      Manifold.decompose() — much cheaper than a trimesh
#      round-trip because it never leaves the Manifold domain.
# ============================================================

def enforce_single_region_manifold(mf, label=""):
    """
    Given a Manifold, decompose it into connected components,
    keep only the largest by triangle count, and return it.

    Operates entirely within manifold3d — no trimesh or numpy
    round-trip — so it is fast even for very large meshes.
    """

    components = mf.decompose()

    if len(components) == 1:
        print(f"  [single-region {label}] mesh already has 1 component — OK")
        return mf

    # pick the largest component by triangle count
    sizes = [c.num_tri() for c in components]
    best_idx = int(np.argmax(sizes))
    best = components[best_idx]

    discarded_tris = sum(sizes) - sizes[best_idx]
    print(
        f"  [single-region {label}] "
        f"{len(components)} components found — "
        f"kept component #{best_idx + 1} "
        f"({sizes[best_idx]} tris), "
        f"discarded {discarded_tris} tris across "
        f"{len(components) - 1} smaller component(s)"
    )

    return best


# ============================================================
# HARDENED REPAIR
# ============================================================

def repair(tm):

    # --------------------------------------------------------
    # Step 1: Drop degenerate (zero-area) faces
    # --------------------------------------------------------
    nondeg_mask = tm.nondegenerate_faces()
    tm = trimesh.Trimesh(
        vertices=tm.vertices,
        faces=tm.faces[nondeg_mask],
        process=False,
    )
    del nondeg_mask

    # --------------------------------------------------------
    # Step 2: Merge vertices that are truly identical
    # --------------------------------------------------------
    try:
        tm.merge_vertices(merge_tex=False, merge_norm=False)
    except TypeError:
        tm.merge_vertices()

    # --------------------------------------------------------
    # Step 3: Remove duplicate faces via numpy unique
    # --------------------------------------------------------
    sorted_faces = np.sort(tm.faces, axis=1)
    _, unique_idx = np.unique(sorted_faces, axis=0, return_index=True)
    tm = trimesh.Trimesh(
        vertices=tm.vertices,
        faces=tm.faces[unique_idx],
        process=False,
    )
    del sorted_faces, unique_idx

    # --------------------------------------------------------
    # Step 4: Remove unreferenced vertices
    # --------------------------------------------------------
    tm.remove_unreferenced_vertices()

    # --------------------------------------------------------
    # Step 5: Fix winding / normals
    # --------------------------------------------------------
    trimesh.repair.fix_normals(tm)

    # --------------------------------------------------------
    # Step 6: Fill holes
    # --------------------------------------------------------
    trimesh.repair.fill_holes(tm)

    # --------------------------------------------------------
    # Step 7: Remove non-manifold faces (VECTORISED — O(F log F)
    # instead of O(F) Python iterations)
    # --------------------------------------------------------
    tm = _strip_nonmanifold_faces_vectorized(tm)

    # --------------------------------------------------------
    # Step 8: Keep only the largest connected component.
    # This is the trimesh-level single-region enforcement;
    # a separate manifold-level check is applied later.
    # --------------------------------------------------------
    components = tm.split(only_watertight=False)

    if len(components) > 1:

        tm = max(components, key=lambda c: len(c.faces))

        print(
            f"  [repair] kept largest component "
            f"({len(tm.faces)} / total faces)"
        )

    del components

    # --------------------------------------------------------
    # Step 9: Final normal pass + hole fill
    # --------------------------------------------------------
    trimesh.repair.fix_normals(tm)

    trimesh.repair.fill_holes(tm)

    # --------------------------------------------------------
    # Step 10: Report
    # --------------------------------------------------------
    _report_mesh_quality(tm, label="after repair")

    return tm


def _report_mesh_quality(tm, label=""):

    edges = tm.edges_sorted
    unique, counts = np.unique(edges, axis=0, return_counts=True)

    nm_edges   = int((counts > 2).sum())
    open_edges = int((counts == 1).sum())

    print(
        f"  [mesh quality {label}] "
        f"faces={len(tm.faces)} | "
        f"verts={len(tm.vertices)} | "
        f"non-manifold edges={nm_edges} | "
        f"open/boundary edges={open_edges} | "
        f"watertight={tm.is_watertight}"
    )


