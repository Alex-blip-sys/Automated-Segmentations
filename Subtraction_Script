def mesh_edge_statistics(tm):
    """Return unique edge-length statistics for a Trimesh surface."""

    if len(tm.faces) == 0:
        raise RuntimeError("Cannot measure an empty mesh.")

    edges = np.asarray(tm.edges_unique, dtype=np.int64)
    verts = np.asarray(tm.vertices, dtype=np.float64)
    lengths = np.linalg.norm(verts[edges[:, 0]] - verts[edges[:, 1]], axis=1)

    if len(lengths) == 0:
        raise RuntimeError("Mesh contains no measurable edges.")

    return {
        "min": float(np.min(lengths)),
        "p01": float(np.percentile(lengths, 1)),
        "p05": float(np.percentile(lengths, 5)),
        "median": float(np.median(lengths)),
        "p95": float(np.percentile(lengths, 95)),
        "p99": float(np.percentile(lengths, 99)),
        "max": float(np.max(lengths)),
    }


def triangle_quality_values(tm):
    """Return a normalized triangle quality in [0, 1].

    q = 4*sqrt(3)*A / (a^2+b^2+c^2)
    q = 1 for an equilateral triangle and approaches 0 for a sliver.
    """

    v = np.asarray(tm.vertices, dtype=np.float64)
    f = np.asarray(tm.faces, dtype=np.int64)

    p0 = v[f[:, 0]]
    p1 = v[f[:, 1]]
    p2 = v[f[:, 2]]

    a2 = np.einsum("ij,ij->i", p1 - p0, p1 - p0)
    b2 = np.einsum("ij,ij->i", p2 - p1, p2 - p1)
    c2 = np.einsum("ij,ij->i", p0 - p2, p0 - p2)

    twice_area = np.linalg.norm(np.cross(p1 - p0, p2 - p0), axis=1)
    denom = a2 + b2 + c2

    q = np.zeros(len(f), dtype=np.float64)
    valid = denom > np.finfo(float).eps
    q[valid] = 2.0 * np.sqrt(3.0) * twice_area[valid] / denom[valid]
    return np.clip(q, 0.0, 1.0)


def report_surface_discretization(tm, label=""):
    """Print metrics that are particularly relevant to TetGen robustness."""

    edge = mesh_edge_statistics(tm)
    q = triangle_quality_values(tm)

    print(f"  [surface discretization {label}]")
    print(
        "    edges: "
        f"min={edge['min']:.6g} | "
        f"p01={edge['p01']:.6g} | "
        f"p05={edge['p05']:.6g} | "
        f"median={edge['median']:.6g} | "
        f"p95={edge['p95']:.6g} | "
        f"max={edge['max']:.6g}"
    )
    print(
        "    triangle quality: "
        f"min={float(np.min(q)):.6g} | "
        f"p01={float(np.percentile(q, 1)):.6g} | "
        f"median={float(np.median(q)):.6g} | "
        f"q<0.05={int(np.sum(q < 0.05))} | "
        f"q<0.10={int(np.sum(q < 0.10))}"
    )

    return edge, q


def estimate_acvd_clusters(pv_mesh, target_edge_length):
    """Estimate ACVD vertex clusters from area and desired edge length.

    For an approximately equilateral triangulation:
        triangle_area ~= sqrt(3)/4 * h^2
        number_of_vertices ~= number_of_triangles / 2
    for a large closed triangular surface.
    """

    if target_edge_length <= 0:
        raise ValueError("target_edge_length must be > 0")

    tri = pv_mesh.triangulate()
    total_area = float(tri.area)

    ideal_tri_area = (np.sqrt(3.0) / 4.0) * target_edge_length**2
    target_triangles = max(4.0, total_area / ideal_tri_area)
    target_vertices = int(round(target_triangles / 2.0))

    target_vertices = max(REMESH_MIN_CLUSTERS, target_vertices)
    target_vertices = min(REMESH_MAX_CLUSTERS, target_vertices)

    # ACVD cannot create more clusters than there are input points unless
    # the surface is explicitly subdivided first. Keep the request valid
    # when REMESH_SUBDIVIDE == 0.
    if REMESH_SUBDIVIDE == 0:
        target_vertices = min(target_vertices, max(4, tri.n_points - 1))

    return target_vertices


def repair_open_surface(tm):
    """Repair an OPEN surface without filling its intended cap holes."""

    nondeg_mask = tm.nondegenerate_faces()
    tm = trimesh.Trimesh(
        vertices=tm.vertices,
        faces=tm.faces[nondeg_mask],
        process=False,
    )

    try:
        tm.merge_vertices(merge_tex=False, merge_norm=False)
    except TypeError:
        tm.merge_vertices()

    sorted_faces = np.sort(tm.faces, axis=1)
    _, unique_idx = np.unique(sorted_faces, axis=0, return_index=True)
    tm = trimesh.Trimesh(
        vertices=tm.vertices,
        faces=tm.faces[unique_idx],
        process=False,
    )

    tm.remove_unreferenced_vertices()
    trimesh.repair.fix_normals(tm)
    tm = _strip_nonmanifold_faces_vectorized(tm)
    tm.remove_unreferenced_vertices()
    trimesh.repair.fix_normals(tm)
    _report_mesh_quality(tm, label="open-surface repair")
    return tm


def _build_face_adjacency_lists(faces):
    """Build edge-neighbor lists for triangular faces using numpy only."""

    faces = np.asarray(faces, dtype=np.int64)
    nf = len(faces)

    e0 = faces[:, [0, 1]]
    e1 = faces[:, [1, 2]]
    e2 = faces[:, [2, 0]]
    edges = np.vstack((e0, e1, e2))
    edges_sorted = np.sort(edges, axis=1)
    face_ids = np.tile(np.arange(nf, dtype=np.int64), 3)

    # Sort edge rows lexicographically so equal edges are consecutive.
    order = np.lexsort((edges_sorted[:, 1], edges_sorted[:, 0]))
    es = edges_sorted[order]
    fs = face_ids[order]

    neighbors = [[] for _ in range(nf)]
    i = 0
    while i < len(es):
        j = i + 1
        while j < len(es) and np.array_equal(es[j], es[i]):
            j += 1

        owners = fs[i:j]
        if len(owners) == 2:
            a, b = int(owners[0]), int(owners[1])
            neighbors[a].append(b)
            neighbors[b].append(a)
        # Non-manifold (>2 owners) should already have been removed by repair().
        i = j

    return neighbors


def strip_all_caps(tm, caps, target_edge_length):
    """Delete legacy caps by edge-connected planar region growing.

    For each original cap, a seed triangle is chosen near the stored cap
    centroid.  The cap is then grown ONLY through edge-adjacent triangles
    that remain close to the original cap plane and whose normals are
    strongly aligned with the original cap normal.  This avoids accidentally
    cutting curved vessel-wall triangles merely because they lie inside the
    cap's radial footprint.
    """

    v = np.asarray(tm.vertices, dtype=np.float64)
    f = np.asarray(tm.faces, dtype=np.int64)
    p0, p1, p2 = v[f[:, 0]], v[f[:, 1]], v[f[:, 2]]
    centroids = (p0 + p1 + p2) / 3.0

    raw_normals = np.cross(p1 - p0, p2 - p0)
    norm_mag = np.linalg.norm(raw_normals, axis=1)
    normals = np.zeros_like(raw_normals)
    valid = norm_mag > np.finfo(float).eps
    normals[valid] = raw_normals[valid] / norm_mag[valid, None]

    print("  Building face adjacency for planar region growing...")
    neighbors = _build_face_adjacency_lists(f)

    remove = np.zeros(len(f), dtype=bool)

    for cap in caps:
        c = np.asarray(cap["centroid"], dtype=np.float64)
        n = np.asarray(cap["normal"], dtype=np.float64)
        n /= np.linalg.norm(n)

        vec = centroids - c
        signed = vec @ n
        alignment = np.abs(normals @ n)

        # Keep this much tighter than the previous radius-based deletion.
        plane_tol = max(
            CAP_GROW_PLANE_TOL_FACTOR * float(cap["plane_tol"]),
            CAP_GROW_PLANE_TOL_EDGE_MULTIPLIER * target_edge_length,
        )

        acceptable = (
            (~remove)
            & (np.abs(signed) <= plane_tol)
            & (alignment >= CAP_GROW_MIN_NORMAL_ALIGNMENT)
        )

        # Seed selection: among acceptable faces reasonably close to the
        # original cap center, choose the centroid-nearest triangle.
        euclid = np.linalg.norm(vec, axis=1)
        seed_radius = max(
            float(cap["radius"]) * CAP_GROW_SEED_SEARCH_RADIUS_SCALE,
            2.0 * target_edge_length,
        )
        seed_candidates = np.where(acceptable & (euclid <= seed_radius))[0]

        if len(seed_candidates) == 0:
            # Fallback: nearest acceptable planar/aligned face anywhere.
            seed_candidates = np.where(acceptable)[0]

        if len(seed_candidates) == 0:
            msg = (
                f"Could not find a planar seed triangle for cap '{cap['name']}' "
                f"(fid={cap['fid']}). Inspect the original cap or "
                "adjust CAP_GROW_MIN_NORMAL_ALIGNMENT carefully."
            )
            CAP_REMOVAL_RECORDS.append({"name": cap["name"], "fid": cap["fid"],
                                        "status": "FAILED_NO_SEED", "reason": msg,
                                        "x": float(c[0]), "y": float(c[1]), "z": float(c[2])})
            if ALLOW_PARTIAL_CAP_REMOVAL:
                print("  WARNING:", msg)
                continue
            raise RuntimeError(msg)

        seed = int(seed_candidates[np.argmin(euclid[seed_candidates])])

        # Breadth-first flood fill through SHARED EDGES only.
        stack = [seed]
        region = []
        visited = set()

        while stack:
            face_id = stack.pop()
            if face_id in visited:
                continue
            visited.add(face_id)

            if remove[face_id] or not acceptable[face_id]:
                continue

            region.append(face_id)
            for nb in neighbors[face_id]:
                if nb not in visited and acceptable[nb] and not remove[nb]:
                    stack.append(nb)

        if len(region) < CAP_GROW_MIN_TRIANGLES:
            msg = (f"Cap '{cap['name']}' (fid={cap['fid']}): "
                   f"only {len(region)} triangles; seed={seed}. "
                   "Likely cap misidentification, poor planarity, or missing cap.")
            CAP_REMOVAL_RECORDS.append({"name": cap["name"], "fid": cap["fid"],
                                        "status": "FAILED_SMALL_REGION", "reason": msg,
                                        "x": float(c[0]), "y": float(c[1]), "z": float(c[2])})
            if ALLOW_PARTIAL_CAP_REMOVAL:
                print("  WARNING:", msg)
                continue
            raise RuntimeError(msg)

        region = np.asarray(region, dtype=np.int64)
        remove[region] = True

        max_plane_error = float(np.max(np.abs(signed[region])))
        min_alignment = float(np.min(alignment[region]))
        region_center = np.mean(centroids[region], axis=0)
        CAP_REMOVAL_RECORDS.append({
            "name": cap["name"], "fid": cap["fid"], "status": "REMOVED",
            "reason": "", "triangles_removed": int(len(region)),
            "max_plane_error": max_plane_error, "min_normal_alignment": min_alignment,
            "x": float(region_center[0]), "y": float(region_center[1]),
            "z": float(region_center[2]), "seed_face": seed
        })
        print(
            f"  [remove old cap] '{cap['name']}': "
            f"region={len(region)} triangles | seed={seed} | "
            f"max plane error={max_plane_error:.6g} | "
            f"min normal alignment={min_alignment:.6f}"
        )

    if not remove.any():
        msg = "No cap triangles were identified for removal. Saving the intact boolean result."
        if not ALLOW_PARTIAL_CAP_REMOVAL:
            raise RuntimeError(msg)
        print("  WARNING:", msg)

    wall = trimesh.Trimesh(
        vertices=v,
        faces=f[~remove],
        process=False,
    )
    wall.remove_unreferenced_vertices()
    # Even the conservative cleanup can sometimes fail on an unusually
    # pathological boolean seam. Keep the raw subtraction-derived opening
    # instead of losing the entire run.
    try:
        repaired_wall = repair_open_surface(wall)
        if repaired_wall.faces.shape[0] == 0:
            raise RuntimeError("Open-wall cleanup removed all triangles")
        wall = repaired_wall
    except Exception as exc:
        print(f"  WARNING: open-wall cleanup failed: {type(exc).__name__}: {exc}")
        print("  Retaining raw cap-stripped surface for manual repair.")

    # Opening topology is inspected in the main diagnostics pipeline.
    # Previously a pinched boundary vertex (degree 4) caused an exception here,
    # preventing any output from being written. We intentionally return the
    # partially opened wall so the offending coordinates can be exported.
    return wall


def uniform_remesh_open_wall(tm, target_edge_length):
    """Uniformly remesh the intentionally OPEN arterial wall with pyACVD."""

    pv_in = tm_to_pv(tm).triangulate().clean()
    n_clusters = estimate_acvd_clusters(pv_in, target_edge_length)

    print(
        f"  Open-wall remesh target edge ~= {target_edge_length:.6g}; "
        f"ACVD clusters={n_clusters:,}; subdivide={REMESH_SUBDIVIDE}"
    )

    if hasattr(pv_in, "acvd") and hasattr(pv_in.acvd, "remesh"):
        pv_out = pv_in.acvd.remesh(
            n_clusters,
            subdivide=REMESH_SUBDIVIDE,
        )
    else:
        clus = pyacvd.Clustering(pv_in)
        if REMESH_SUBDIVIDE > 0:
            clus.subdivide(REMESH_SUBDIVIDE)
        clus.cluster(n_clusters)
        pv_out = clus.create_mesh()

    pv_out = pv_out.triangulate().clean()
    return repair_open_surface(pv_to_tm(pv_out))


def boundary_loops_from_trimesh(tm):
    """Return ordered vertex-index loops for every boundary component."""

    faces = np.asarray(tm.faces, dtype=np.int64)
    e0 = faces[:, [0, 1]]
    e1 = faces[:, [1, 2]]
    e2 = faces[:, [2, 0]]
    edges = np.vstack((e0, e1, e2))
    sorted_edges = np.sort(edges, axis=1)

    _, inv, counts = np.unique(
        sorted_edges, axis=0, return_inverse=True, return_counts=True
    )
    boundary_edges = edges[counts[inv] == 1]

    if len(boundary_edges) == 0:
        return []

    adjacency = {}
    for a, b in boundary_edges:
        adjacency.setdefault(int(a), []).append(int(b))
        adjacency.setdefault(int(b), []).append(int(a))

    bad_degree = {k: len(v) for k, v in adjacency.items() if len(v) != 2}
    if bad_degree:
        sample = list(bad_degree.items())[:10]
        raise RuntimeError(
            "Boundary is not composed of simple closed loops. "
            f"Found vertices with degree != 2, e.g. {sample}"
        )

    loops = []
    unvisited = set(adjacency)

    while unvisited:
        start = next(iter(unvisited))
        loop = [start]
        prev = None
        curr = start

        while True:
            nbrs = adjacency[curr]
            nxt = nbrs[0] if nbrs[0] != prev else nbrs[1]
            if nxt == start:
                break
            if nxt in loop:
                raise RuntimeError("Encountered a self-crossing boundary loop.")
            loop.append(nxt)
            prev, curr = curr, nxt

        for vid in loop:
            unvisited.discard(vid)
        loops.append(np.asarray(loop, dtype=np.int64))

    loops.sort(key=len, reverse=True)
    return loops


def match_boundary_loops_to_caps(tm, loops, caps, target_edge_length):
    """Match each open boundary loop uniquely to stored original cap metadata."""

    pts = np.asarray(tm.vertices, dtype=np.float64)
    candidates = []

    for li, loop in enumerate(loops):
        lc = pts[loop].mean(axis=0)
        for ci, cap in enumerate(caps):
            c = np.asarray(cap["centroid"], dtype=np.float64)
            n = np.asarray(cap["normal"], dtype=np.float64)
            n /= np.linalg.norm(n)
            d = lc - c
            plane = abs(float(d @ n))
            radial = np.linalg.norm(d - (d @ n) * n)
            radius = max(float(cap["radius"]), target_edge_length)
            score = radial / radius + plane / max(radius, target_edge_length)
            candidates.append((score, li, ci, radial, plane))

    candidates.sort(key=lambda x: x[0])
    used_loops = set()
    used_caps = set()
    matches = {}

    for score, li, ci, radial, plane in candidates:
        if li in used_loops or ci in used_caps:
            continue
        if score > CAP_MATCH_MAX_SCORE:
            continue
        matches[li] = ci
        used_loops.add(li)
        used_caps.add(ci)

    if len(matches) != len(loops) or len(matches) != len(caps):
        unmatched_loops = sorted(set(range(len(loops))) - set(matches))
        unmatched_caps = [caps[i]["name"] for i in range(len(caps)) if i not in used_caps]
        raise RuntimeError(
            "Could not obtain a one-to-one boundary-loop/cap match. "
            f"loops={len(loops)}, caps={len(caps)}, matches={len(matches)}, "
            f"unmatched_loops={unmatched_loops[:10]}, "
            f"unmatched_caps={unmatched_caps[:10]}"
        )

    for li in sorted(matches):
        cap = caps[matches[li]]
        print(
            f"  [boundary match] loop {li + 1:02d} "
            f"({len(loops[li])} verts) -> '{cap['name']}'"
        )

    return matches


def triangulate_planar_loop_vtk(loop_points):
    """Triangulate a planar closed contour using VTK's contour triangulator."""

    try:
        import vtk
    except ImportError as exc:
        raise RuntimeError(
            "VTK is required for cap triangulation; it is normally installed "
            "automatically with PyVista."
        ) from exc

    n = len(loop_points)
    if n < 3:
        raise RuntimeError("Cannot triangulate a cap with fewer than 3 points.")

    vtk_pts = vtk.vtkPoints()
    for p in loop_points:
        vtk_pts.InsertNextPoint(float(p[0]), float(p[1]), float(p[2]))

    lines = vtk.vtkCellArray()
    for i in range(n):
        line = vtk.vtkLine()
        line.GetPointIds().SetId(0, i)
        line.GetPointIds().SetId(1, (i + 1) % n)
        lines.InsertNextCell(line)

    poly = vtk.vtkPolyData()
    poly.SetPoints(vtk_pts)
    poly.SetLines(lines)

    tri_filter = vtk.vtkContourTriangulator()
    tri_filter.SetInputData(poly)
    tri_filter.Update()

    out = pv.wrap(tri_filter.GetOutput()).triangulate()
    if out.n_cells == 0:
        raise RuntimeError("vtkContourTriangulator produced zero cap triangles.")

    if out.n_points != n:
        raise RuntimeError(
            "vtkContourTriangulator unexpectedly changed the contour point count "
            f"({n} -> {out.n_points})."
        )

    faces = out.faces.reshape(-1, 4)[:, 1:].astype(np.int64, copy=True)
    return faces


def rebuild_caps_from_boundary_loops(tm_wall, caps, target_edge_length):
    """Snap open loops to original planes and generate entirely new caps.

    Returns a closed PyVista PolyData with ModelFaceID already assigned.
    """

    loops = boundary_loops_from_trimesh(tm_wall)
    print(f"Detected {len(loops)} open boundary loops; expected {len(caps)} caps")

    if len(loops) != len(caps):
        raise RuntimeError(
            f"Expected {len(caps)} boundary loops after deleting caps, "
            f"but found {len(loops)}. Inspect {DEBUG_REMESHED_OPEN_WALL_VTP}."
        )

    matches = match_boundary_loops_to_caps(
        tm_wall, loops, caps, target_edge_length
    )

    vertices = np.asarray(tm_wall.vertices, dtype=np.float64).copy()
    wall_faces = np.asarray(tm_wall.faces, dtype=np.int64).copy()
    wall_fid = max(c["fid"] for c in caps) + 1

    all_faces = [wall_faces]
    all_ids = [np.full(len(wall_faces), wall_fid, dtype=np.int32)]

    for li, loop in enumerate(loops):
        cap = caps[matches[li]]
        c = np.asarray(cap["centroid"], dtype=np.float64)
        n = np.asarray(cap["normal"], dtype=np.float64)
        n /= np.linalg.norm(n)

        if SNAP_BOUNDARIES_TO_ORIGINAL_PLANES:
            d = (vertices[loop] - c) @ n
            vertices[loop] -= np.outer(d, n)

        local_points = vertices[loop]
        local_faces = triangulate_planar_loop_vtk(local_points)
        global_faces = loop[local_faces]

        all_faces.append(global_faces)
        all_ids.append(np.full(len(global_faces), cap["fid"], dtype=np.int32))

        # Quality report for this newly created cap.
        cap_tm = trimesh.Trimesh(
            vertices=vertices,
            faces=global_faces,
            process=False,
        )
        q = triangle_quality_values(cap_tm)
        print(
            f"  [new cap] '{cap['name']}': {len(global_faces)} tris | "
            f"q_min={np.min(q):.5g} | q01={np.percentile(q,1):.5g}"
        )

    faces = np.vstack(all_faces)
    face_ids = np.concatenate(all_ids)

    closed_tm = trimesh.Trimesh(
        vertices=vertices,
        faces=faces,
        process=False,
    )
    trimesh.repair.fix_normals(closed_tm)
    _report_mesh_quality(closed_tm, label="after fresh recapping")
    report_surface_discretization(closed_tm, label="freshly recapped")

    if not closed_tm.is_watertight:
        raise RuntimeError(
            "Freshly recapped surface is not watertight. Inspect the debug outputs."
        )

    pv_result = tm_to_pv(closed_tm)
    pv_result.cell_data["ModelFaceID"] = face_ids

    assignments = {c["fid"]: c["name"] for c in caps}
    assignments[wall_fid] = "wall"
    return pv_result, assignments


# ============================================================
# EXTRACT PLANAR CAP INFO
# ============================================================

def extract_cap_info(
    surface,
    facename_file,
    percentile=80
):

    face_map = read_facenames(facename_file)

    cap_entries = {
        fid: name
        for fid, name in face_map.items()
        if "wall" not in name.lower()
    }

    if "ModelFaceID" not in surface.cell_data:

        raise RuntimeError(
            "ModelFaceID missing from mesh."
        )

    mf_ids = surface.cell_data["ModelFaceID"]

    caps = []

    for fid, name in cap_entries.items():

        cell_ids = np.where(mf_ids == fid)[0]

        if len(cell_ids) == 0:

            print(
                f"WARNING: cap '{name}' has no cells"
            )

            continue

        sub = surface.extract_cells(cell_ids)
        sub_clean = sub.clean()
        pts = np.array(sub_clean.points)
        # Retain original cap surface area to detect accidental wall capture
        # or incomplete cap matches after manifold boolean operations.
        reference_cap_area = float(sub_clean.extract_surface().triangulate().area)
        centroid = pts.mean(axis=0)
        centered = pts - centroid
        _, _, vh = np.linalg.svd(centered, full_matrices=False)

        normal = vh[-1]

        normal = normal / np.linalg.norm(normal)

        vec = pts - centroid

        plane_component = np.outer(
            np.dot(vec, normal),
            normal
        )

        projected = vec - plane_component

        radial_dist = np.linalg.norm(
            projected,
            axis=1
        )

        radius = np.percentile(
            radial_dist,
            percentile
        )

        plane_tol = (
            radius * PLANE_TOL_FACTOR
        )

        caps.append({

            "fid": fid,

            "name": name,

            "centroid": centroid,

            "normal": normal,

            "radius": radius,

            "plane_tol": plane_tol,
            "surface_area": reference_cap_area,
        })

        print(
            f"Cap '{name}' | "
            f"fid={fid} | "
            f"radius={radius:.4f} | "
            f"plane_tol={plane_tol:.4f}"
        )

    return caps


# ============================================================
# PLANAR CAP ASSIGNMENT
# ============================================================

def build_assignments(
    pv_result,
    caps
):

    tri = pv_result.triangulate()

    faces = tri.faces.reshape(-1, 4)[:, 1:]

    pts = tri.points

    cell_centroids = pts[faces].mean(axis=1)

    face_id_array = np.zeros(
        tri.n_cells,
        dtype=int
    )

    for cap in caps:

        centroid = cap["centroid"]

        normal = cap["normal"]

        radius = cap["radius"]

        plane_tol = cap["plane_tol"]

        vec = cell_centroids - centroid

        plane_dist = np.abs(
            np.dot(vec, normal)
        )

        projected = vec - np.outer(
            np.dot(vec, normal),
            normal
        )

        radial_dist = np.linalg.norm(
            projected,
            axis=1
        )

        mask = (
            (plane_dist <= plane_tol) &
            (radial_dist <= radius)
        )

        face_id_array[mask] = cap["fid"]

        print(
            f"Assigned cap '{cap['name']}' "
            f"-> {mask.sum()} cells"
        )

    wall_fid = max(
        c["fid"] for c in caps
    ) + 1

    wall_mask = face_id_array == 0

    face_id_array[wall_mask] = wall_fid

    print(
        f"Assigned wall -> "
        f"{wall_mask.sum()} cells"
    )

    tri.cell_data["ModelFaceID"] = face_id_array

    assignments = {
        c["fid"]: c["name"]
        for c in caps
    }

    assignments[wall_fid] = "wall"

    return tri, assignments


