def _status(stage, message, *, severity="info"):
    PIPELINE_REPORT["stages"].append({"stage": stage, "severity": severity,
                                      "message": str(message)})
    if severity == "warning":
        PIPELINE_REPORT["warnings"].append(str(message))
    elif severity == "error":
        PIPELINE_REPORT["errors"].append(str(message))
    print(f"  [{severity.upper()}] {stage}: {message}")
    _save_pipeline_report()


def _cap_matcher(caps):
    centers = np.array([c["centroid"] for c in caps], dtype=np.float64)
    normals = np.array([c["normal"] for c in caps], dtype=np.float64)
    radii = np.array([max(float(c["radius"]), 1e-12) for c in caps])
    # KDTree accelerates lookups on models with hundreds of caps. It is only
    # used for diagnostics; missing SciPy is handled by a NumPy fallback.
    try:
        from scipy.spatial import cKDTree
        tree = cKDTree(centers)
    except ImportError:
        tree = None

    def match(xyz, n=3):
        if not caps:
            return []
        xyz = np.asarray(xyz, dtype=np.float64)
        k = min(len(caps), max(n * 4, 10))
        if tree is not None:
            _, ids = tree.query(xyz, k=k)
            ids = np.atleast_1d(ids).astype(np.int64)
        else:
            d2 = np.einsum('ij,ij->i', centers - xyz, centers - xyz)
            ids = np.argsort(d2)[:k]
        off = xyz - centers[ids]
        axial = np.abs(np.einsum('ij,ij->i', off, normals[ids]))
        lateral = np.linalg.norm(off - np.einsum('ij,ij->i', off, normals[ids])[:, None] * normals[ids], axis=1)
        score = np.hypot(axial / radii[ids], lateral / radii[ids])
        best = np.argsort(score)[:n]
        return [{"name": str(caps[ids[j]]["name"]),
                 "fid": int(caps[ids[j]]["fid"]),
                 "distance": float(np.linalg.norm(off[j])),
                 "plane_offset": float(axial[j]),
                 "radial_offset": float(lateral[j]),
                 "normalized_score": float(score[j])} for j in best]
    return match


def _make_point_markers(xyz, numeric_arrays, path):
    xyz = np.asarray(xyz, dtype=float).reshape(-1, 3)
    if len(xyz) == 0:
        return
    poly = pv.PolyData(xyz)
    poly.verts = np.column_stack((np.ones(len(xyz), dtype=np.int64),
                                  np.arange(len(xyz), dtype=np.int64))).ravel()
    for key, val in numeric_arrays.items():
        poly.point_data[key] = np.asarray(val)
    poly.save(str(path))


def boundary_diagnostics(tm, caps, stage, *, export=True):
    """Analyze open edges, branching boundary vertices, and opening components.

    Never raises due to malformed boundary topology. Reports coordinates of
    degree != 2 vertices (pinched/touching/crossing boundary cycles) and the
    nearest reference caps. A nearest cap is a clue, NOT proof of causation.
    """
    verts = np.asarray(tm.vertices, dtype=np.float64)
    faces = np.asarray(tm.faces, dtype=np.int64)
    # This process is vectorized even for multi-million-cell models.
    edges = np.vstack((faces[:, [0, 1]], faces[:, [1, 2]], faces[:, [2, 0]]))
    edges.sort(axis=1)
    unique, counts = np.unique(edges, axis=0, return_counts=True)
    boundary_edges = unique[counts == 1]
    nonmanifold_edges = unique[counts > 2]
    del edges, unique, counts

    degree = np.bincount(boundary_edges.ravel(), minlength=len(verts))
    bad = np.flatnonzero((degree > 0) & (degree != 2))
    match = _cap_matcher(caps)
    stage_dir = DIAGNOSTIC_DIR / stage
    if export:
        stage_dir.mkdir(parents=True, exist_ok=True)

    # Connected components of the 1D boundary graph. Components can contain
    # two or more merged loops if one vertex has degree 4 (figure-eight).
    graph = defaultdict(list)
    for a, b in boundary_edges:
        a, b = int(a), int(b)
        graph[a].append(b)
        graph[b].append(a)
    components = []
    component_of_vertex = {}
    for root in graph:
        if root in component_of_vertex:
            continue
        component_id = len(components) + 1
        queue = deque([root])
        component_of_vertex[root] = component_id
        members = []
        while queue:
            v = queue.popleft()
            members.append(v)
            for nb in graph[v]:
                if nb not in component_of_vertex:
                    component_of_vertex[nb] = component_id
                    queue.append(nb)
        components.append(members)

    component_rows = []
    for i, members in enumerate(components, start=1):
        ids = np.asarray(members, dtype=np.int64)
        xyz = verts[ids]
        center = xyz.mean(axis=0)
        degree_bad = ids[degree[ids] != 2]
        nearest = match(center, n=3)
        # Vertex-wise matching helps identify TWO caps meeting at a degree-4
        # junction (component centroid alone might not reveal both).
        suspicious_names = set()
        for bad_id in degree_bad[:20]:
            for m in match(verts[int(bad_id)], n=2):
                suspicious_names.add(m["name"])
        component_rows.append({
            "component_id": i, "vertices": int(len(ids)),
            "boundary_edges": int(sum(len(graph[j]) for j in members) // 2),
            "bad_degree_vertices": int(len(degree_bad)),
            "max_degree": int(degree[ids].max()),
            "closed_simple_loop": int(len(degree_bad) == 0),
            "x": float(center[0]), "y": float(center[1]), "z": float(center[2]),
            "min_x": float(xyz[:, 0].min()), "max_x": float(xyz[:, 0].max()),
            "min_y": float(xyz[:, 1].min()), "max_y": float(xyz[:, 1].max()),
            "min_z": float(xyz[:, 2].min()), "max_z": float(xyz[:, 2].max()),
            "nearest_cap": nearest[0]["name"] if nearest else "",
            "nearest_cap_fid": nearest[0]["fid"] if nearest else -1,
            "cap_candidates": "; ".join(sorted(suspicious_names)) or "; ".join(m["name"] for m in nearest),
            "nearest_cap_score": nearest[0]["normalized_score"] if nearest else "",
        })

    bad_rows = []
    nearest_ids = []
    group_ids = []
    for vid in bad:
        near = match(verts[int(vid)], n=3)
        p = verts[int(vid)]
        cid = component_of_vertex.get(int(vid), -1)
        nearest_ids.append(near[0]["fid"] if near else -1)
        group_ids.append(cid)
        bad_rows.append({
            "vertex_id": int(vid), "boundary_degree": int(degree[vid]),
            "component_id": cid,
            "x": float(p[0]), "y": float(p[1]), "z": float(p[2]),
            "nearest_cap": near[0]["name"] if near else "",
            "nearest_cap_fid": near[0]["fid"] if near else -1,
            "nearest_cap_normalized_distance": near[0]["normalized_score"] if near else "",
            "other_nearby_caps": "; ".join(c["name"] for c in near[1:]),
        })

    summary = {
        "stage": stage, "faces": int(len(faces)), "vertices": int(len(verts)),
        "boundary_edges": int(len(boundary_edges)),
        "nonmanifold_edges": int(len(nonmanifold_edges)),
        "boundary_components": int(len(components)),
        "simple_closed_loops": int(sum(x["closed_simple_loop"] for x in component_rows)),
        "bad_degree_vertices": int(len(bad)),
        "expected_caps": int(len(caps)),
        "safe_to_treat_as_clean_open_surface": bool(len(bad) == 0 and
            len(nonmanifold_edges) == 0 and len(components) == len(caps) and
            all(r["closed_simple_loop"] for r in component_rows)),
    }
    if export:
        _write_csv(stage_dir / "boundary_components.csv", component_rows,
                   ["component_id", "vertices", "boundary_edges", "bad_degree_vertices",
                    "max_degree", "closed_simple_loop", "x", "y", "z",
                    "min_x", "max_x", "min_y", "max_y", "min_z", "max_z",
                    "nearest_cap", "nearest_cap_fid", "cap_candidates", "nearest_cap_score"])
        _write_csv(stage_dir / "broken_boundary_vertices.csv", bad_rows,
                   ["vertex_id", "boundary_degree", "component_id", "x", "y", "z",
                    "nearest_cap", "nearest_cap_fid", "nearest_cap_normalized_distance", "other_nearby_caps"])
        (stage_dir / "boundary_summary.json").write_text(
            json.dumps(summary, indent=2), encoding="utf-8")
        if len(nonmanifold_edges):
            edge_midpoints = verts[nonmanifold_edges].mean(axis=1)
            nm_rows = []
            cap_ids = []
            for e, pt in zip(nonmanifold_edges, edge_midpoints):
                near = match(pt, n=3)
                fid = near[0]["fid"] if near else -1
                cap_ids.append(fid)
                nm_rows.append({"vertex_id_a": int(e[0]), "vertex_id_b": int(e[1]),
                                "x": float(pt[0]), "y": float(pt[1]), "z": float(pt[2]),
                                "nearest_cap": near[0]["name"] if near else "",
                                "nearest_cap_fid": fid,
                                "other_nearby_caps": "; ".join(m["name"] for m in near[1:])})
            _write_csv(stage_dir / "nonmanifold_edge_locations.csv", nm_rows,
                       ["vertex_id_a", "vertex_id_b", "x", "y", "z", "nearest_cap",
                        "nearest_cap_fid", "other_nearby_caps"])
            _make_point_markers(edge_midpoints, {
                "OriginalVertexA": nonmanifold_edges[:, 0].astype(np.int64),
                "OriginalVertexB": nonmanifold_edges[:, 1].astype(np.int64),
                "NearestCapFID": np.asarray(cap_ids, dtype=np.int32),
            }, stage_dir / "nonmanifold_edge_midpoints.vtp")
        if len(bad):
            _make_point_markers(verts[bad], {
                "OriginalVertexID": bad.astype(np.int64),
                "BoundaryDegree": degree[bad].astype(np.int32),
                "ComponentID": np.array(group_ids, dtype=np.int32),
                "NearestCapFID": np.array(nearest_ids, dtype=np.int32),
            }, stage_dir / "broken_boundary_vertices.vtp")
        if len(boundary_edges):
            used = np.unique(boundary_edges)
            local = np.searchsorted(used, boundary_edges)
            lines = np.column_stack((np.full(len(local), 2, dtype=np.int64), local)).ravel()
            poly = pv.PolyData(verts[used], lines=lines)
            poly.point_data["OriginalVertexID"] = used.astype(np.int64)
            poly.point_data["BoundaryDegree"] = degree[used].astype(np.int32)
            poly.cell_data["ComponentID"] = np.array([
                component_of_vertex[int(e[0])] for e in boundary_edges], dtype=np.int32)
            poly.save(str(stage_dir / "boundary_edges.vtp"))
        if len(components):
            centers = [[r["x"], r["y"], r["z"]] for r in component_rows]
            _make_point_markers(centers, {
                "ComponentID": np.arange(1, len(components) + 1, dtype=np.int32),
                "BadVertexCount": np.array([r["bad_degree_vertices"] for r in component_rows], dtype=np.int32),
                "NearestCapFID": np.array([r["nearest_cap_fid"] for r in component_rows], dtype=np.int32),
            }, stage_dir / "boundary_component_centers.vtp")

        # Export a small set of context patches near the highest-priority bad
        # components. Always use the original mesh for surgical/manual repair.
        problem_rows = sorted((r for r in component_rows if r["bad_degree_vertices"]),
                              key=lambda r: (-r["bad_degree_vertices"], r["component_id"]))
        if problem_rows and DIAGNOSTIC_MAX_PATCHES > 0:
            # Reuse one spatial index for all patches when SciPy is available.
            tri_centers = verts[faces].mean(axis=1)
            try:
                from scipy.spatial import cKDTree
                face_tree = cKDTree(tri_centers)
            except ImportError:
                face_tree = None
            for row in problem_rows[:DIAGNOSTIC_MAX_PATCHES]:
                xyz = np.array([row["x"], row["y"], row["z"]])
                cap = next((c for c in caps if c["fid"] == row["nearest_cap_fid"]), None)
                radius = max(2.0 * float(cap["radius"]) if cap else 0.0,
                             float(np.linalg.norm(verts.max(axis=0) - verts.min(axis=0))) * 0.005)
                radius *= DIAGNOSTIC_PATCH_RADIUS_MULTIPLIER
                if face_tree is not None:
                    chosen = np.asarray(face_tree.query_ball_point(xyz, radius), dtype=np.int64)
                else:
                    chosen = np.flatnonzero(np.linalg.norm(tri_centers - xyz, axis=1) <= radius)
                if len(chosen) == 0:
                    continue
                patch_tm = trimesh.Trimesh(vertices=verts, faces=faces[chosen], process=False)
                patch_tm.remove_unreferenced_vertices()
                patch = tm_to_pv(patch_tm)
                patch.save(str(stage_dir / f"component_{row['component_id']:04d}_context.vtp"))
            del tri_centers

    print(f"  [boundary {stage}] {summary['boundary_edges']} open edges | "
          f"{summary['boundary_components']} components | "
          f"{summary['bad_degree_vertices']} branch/touch vertices | "
          f"{summary['nonmanifold_edges']} nonmanifold edges | "
          f"expected {summary['expected_caps']} caps")
    for r in sorted((r for r in component_rows if r["bad_degree_vertices"]),
                    key=lambda r: -r["bad_degree_vertices"])[:12]:
        print(f"    PROBLEM component {r['component_id']}: "
              f"bad_vertices={r['bad_degree_vertices']} "
              f"XYZ=({r['x']:.6g},{r['y']:.6g},{r['z']:.6g}) "
              f"near {r['cap_candidates']}")
    return summary


