# POST-BOOLEAN CLOSED SURFACE: ModelFaceID + FACENAMES
# ============================================================

def assign_closed_boolean_cap_faces(tm, caps, source_facenames, local_edge_length):
    """Recognize retained cap triangles on a *closed* boolean surface.

    After manifold3d/trimesh booleans the input's old cell-data labels are
    unavailable. We therefore use the original cap geometry (centroid,
    plane normal, radius, and surface area) as a spatial reference.

    Find triangles locally with cKDTree, then assign the single edge-connected
    planar component around the cap center. This avoids allocating a global
    3-million-face adjacency list or testing every face for every cap.

    Ambiguous/missing caps remain wall and are explicitly reported. This
    function does not change a single vertex or triangle of the boolean mesh.
    """
    try:
        from scipy.spatial import cKDTree
    except ImportError as exc:
        raise RuntimeError(
            "Closed cap assignment needs SciPy's cKDTree. "
            "Install scipy in the running Python environment."
        ) from exc

    face_names = {int(fid): str(name) for fid, name in source_facenames.items()}
    wall_entries = [(fid, name) for fid, name in face_names.items()
                    if "wall" in name.lower()]
    if len(wall_entries) == 1:
        wall_fid, wall_name = wall_entries[0]
    elif len(wall_entries) == 0:
        wall_fid = max(face_names, default=0) + 1
        wall_name = "wall"
        print(f"  WARNING: source .facenames has no wall entry; using new ID={wall_fid}")
    else:
        # Do not arbitrarily select from multiple wall surfaces.
        raise RuntimeError(f"Multiple wall-named faces in source: {wall_entries}")

    vertices = np.asarray(tm.vertices, dtype=np.float64)
    faces = np.asarray(tm.faces, dtype=np.int64)
    n_faces = len(faces)
    if n_faces == 0:
        raise RuntimeError("Boolean surface contains no triangles")

    # Compute face centroids/normals/areas in chunks. This controls temporary
    # allocations on multimillion-triangle pulmonary-artery geometries.
    centroids = np.empty((n_faces, 3), dtype=np.float64)
    normals = np.empty((n_faces, 3), dtype=np.float32)
    face_areas = np.empty(n_faces, dtype=np.float32)
    for start in range(0, n_faces, 200_000):
        end = min(start + 200_000, n_faces)
        tri = faces[start:end]
        a, b, c = vertices[tri[:, 0]], vertices[tri[:, 1]], vertices[tri[:, 2]]
        centroids[start:end] = (a + b + c) / 3.0
        cross = np.cross(b - a, c - a)
        double_area = np.linalg.norm(cross, axis=1)
        face_areas[start:end] = 0.5 * double_area
        good = double_area > 1.0e-20
        cross[good] /= double_area[good, None]
        cross[~good] = 0
        normals[start:end] = cross

    print(f"  Indexing {n_faces:,} closed-surface triangles for spatial cap matching...")
    centroid_tree = cKDTree(centroids)
    face_ids = np.full(n_faces, int(wall_fid), dtype=np.int32)
    records = []
    assigned_names = {int(wall_fid): wall_name}
    n_done = 0

    for cap in caps:
        fid = int(cap["fid"])
        name = str(cap["name"])
        center = np.asarray(cap["centroid"], dtype=np.float64)
        normal = np.asarray(cap["normal"], dtype=np.float64)
        normal /= max(float(np.linalg.norm(normal)), 1.0e-30)
        radius = float(cap["radius"])
        reference_area = float(cap.get("surface_area", 0.0))
        record = {
            "name": name, "fid": fid, "reference_area": reference_area,
            "x": float(center[0]), "y": float(center[1]), "z": float(center[2]),
            "status": "UNTESTED", "triangles": 0,
            "area_ratio": "", "max_plane_error": "", "min_normal_alignment": "",
            "overlapping_candidates": 0, "reason": "",
        }

        search_radius = max(
            radius * CLOSED_CAP_SEARCH_RADIUS_FACTOR
            + CLOSED_CAP_EXTRA_SEARCH_EDGES * local_edge_length,
            4.0 * local_edge_length,
        )
        ids = np.asarray(centroid_tree.query_ball_point(center, search_radius),
                         dtype=np.int64)
        if len(ids) == 0:
            record.update(status="MISSING", reason="No triangles near original cap center")
            records.append(record)
            continue

        offsets = centroids[ids] - center
        signed_distance = offsets @ normal
        radial_distance = np.linalg.norm(
            offsets - signed_distance[:, None] * normal, axis=1)
        alignments = np.abs(normals[ids].astype(np.float64) @ normal)
        plane_tol = max(
            CLOSED_CAP_PLANE_TOL_MULTIPLIER * float(cap["plane_tol"]),
            CLOSED_CAP_MIN_PLANE_EDGE_TOL * local_edge_length,
        )
        mask = ((np.abs(signed_distance) <= plane_tol)
                & (alignments >= CLOSED_CAP_MIN_NORMAL_ALIGNMENT)
                & (radial_distance <= search_radius))
        eligible = ids[mask]
        if len(eligible) < CLOSED_CAP_MIN_CONNECTED_TRIANGLES:
            record.update(status="MISSING", reason=(
                f"Only {len(eligible)} locally planar, aligned triangles; "
                f"plane_tol={plane_tol:.6g}"))
            records.append(record)
            continue

        eligible_offsets = offsets[mask]
        near = np.linalg.norm(eligible_offsets, axis=1)
        seed_limit = max(0.7 * radius, 2.0 * local_edge_length)
        if np.min(near) > seed_limit:
            record.update(status="MISSING", reason=(
                f"Nearest eligible triangle is {np.min(near):.6g} from cap center, "
                f"beyond seed limit {seed_limit:.6g}"))
            records.append(record)
            continue
        seed = int(eligible[int(np.argmin(near))])

        # Locally assemble edge adjacency. Global O(F) Python lists would use
        # excessive memory, especially with >1000 outlet caps.
        neighbors = defaultdict(list)
        edge_owner = {}
        for global_id in eligible:
            gid = int(global_id)
            p0, p1, p2 = (int(v) for v in faces[gid])
            for u, v in ((p0, p1), (p1, p2), (p2, p0)):
                edge = (u, v) if u < v else (v, u)
                if edge in edge_owner:
                    other = edge_owner[edge]
                    neighbors[gid].append(other)
                    neighbors[other].append(gid)
                else:
                    edge_owner[edge] = gid

        region = []
        stack = [seed]
        seen = set()
        while stack:
            current = stack.pop()
            if current in seen:
                continue
            seen.add(current)
            region.append(current)
            stack.extend(other for other in neighbors[current] if other not in seen)
        region = np.asarray(region, dtype=np.int64)
        if len(region) < CLOSED_CAP_MIN_CONNECTED_TRIANGLES:
            record.update(status="MISSING", reason=(
                f"Seed's connected patch has only {len(region)} triangles"))
            records.append(record)
            continue

        overlap = int(np.count_nonzero(face_ids[region] != wall_fid))
        record["overlapping_candidates"] = overlap
        if overlap:
            record.update(status="AMBIGUOUS", reason=(
                f"{overlap} triangles already assigned to another cap"))
            records.append(record)
            continue

        area = float(np.sum(face_areas[region], dtype=np.float64))
        ratio = area / reference_area if reference_area > 0 else float("nan")
        record["area_ratio"] = ratio
        record["triangles"] = int(len(region))
        # Oversized patches indicate planar vessel wall or an adjacent cap
        # was accidentally reached. Never label a suspicious patch as a cap.
        if reference_area > 0 and ratio > CLOSED_CAP_MAX_AREA_RATIO:
            record.update(status="AMBIGUOUS", reason=(
                f"Planar patch area is {ratio:.3f} times reference cap area"))
            records.append(record)
            continue

        face_ids[region] = fid
        assigned_names[fid] = name
        n_done += 1
        record["max_plane_error"] = float(
            np.max(np.abs((centroids[region] - center) @ normal)))
        record["min_normal_alignment"] = float(
            np.min(np.abs(normals[region].astype(np.float64) @ normal)))
        if reference_area > 0 and ratio < CLOSED_CAP_MIN_AREA_RATIO_WARNING:
            record.update(status="PARTIAL", reason=(
                f"Region covers only {ratio:.3f} of original cap area"))
        else:
            record["status"] = "ASSIGNED"
        center_found = np.mean(centroids[region], axis=0)
        record["x"], record["y"], record["z"] = map(float, center_found)
        records.append(record)

        if n_done <= 5 or n_done % CLOSED_CAP_PRINT_EVERY == 0:
            print(f"  [closed cap] {name} (fid {fid}): {len(region)} triangles; "
                  f"area/reference={ratio:.3f}; {record['status']}")

    unique_ids = set(int(v) for v in np.unique(face_ids))
    expected_ids = set(assigned_names)
    if unique_ids != expected_ids:
        raise RuntimeError("Internal face ID/facenames disagreement: "
                           f"mesh={unique_ids}, facenames={expected_ids}")
    if not np.all(np.isin(face_ids, np.asarray(list(expected_ids)))):
        raise RuntimeError("Unmapped ModelFaceID in output")

    problematic = [r for r in records if r["status"] not in ("ASSIGNED",)]
    print(f"  Closed cap assignment: {n_done}/{len(caps)} caps labeled; "
          f"{len(problematic)} partial/ambiguous/missing; "
          f"{int(np.count_nonzero(face_ids == wall_fid)):,} wall triangles")
    for rec in problematic[:20]:
        print(f"    WARNING {rec['name']}: {rec['status']} — {rec['reason']} "
              f"XYZ=({rec['x']:.6g}, {rec['y']:.6g}, {rec['z']:.6g})")
    if len(problematic) > 20:
        print(f"    ... {len(problematic)-20} additional warnings in CSV")
    return face_ids, assigned_names, records


def write_closed_boolean_with_facenames(tm, caps, edge_length):
    """Write the primary closed VTP with cell ModelFaceID and matching names."""
    DIAGNOSTIC_DIR.mkdir(parents=True, exist_ok=True)
    source_face_names = read_facenames(OLD_FACENAMES)
    if not source_face_names:
        raise RuntimeError(f"No face entries found in {OLD_FACENAMES}")
    ids, names, records = assign_closed_boolean_cap_faces(
        tm, caps, source_face_names, edge_length)
    output_poly = tm_to_pv(tm)
    output_poly.cell_data["ModelFaceID"] = ids
    output_poly.save(CLOSED_BOOLEAN_OUTPUT_VTP)
    write_facenames(CLOSED_BOOLEAN_OUTPUT_FACENAMES, names)

    # Also report named reference caps whose ModelFaceID is entirely absent
    # from the ORIGINAL healthy model, since extract_cap_info() skips them.
    source_cap_ids = {fid for fid, label in source_face_names.items()
                      if "wall" not in label.lower()}
    extracted_cap_ids = {int(c["fid"]) for c in caps}
    for fid in sorted(source_cap_ids - extracted_cap_ids):
        records.append({
            "name": source_face_names[fid], "fid": fid,
            "status": "MISSING_IN_SOURCE", "reason": (
                "Face name exists in original .facenames but has no labeled "
                "triangles in the original VTP"),
            "triangles": 0,
        })

    report_path = DIAGNOSTIC_DIR / "closed_boolean_cap_assignment.csv"
    _write_csv(report_path, records, [
        "name", "fid", "status", "reason", "triangles", "reference_area",
        "area_ratio", "max_plane_error", "min_normal_alignment",
        "overlapping_candidates", "x", "y", "z",
    ])
    missing = [r["name"] for r in records
               if r["status"] in ("MISSING", "AMBIGUOUS", "MISSING_IN_SOURCE")]
    partial = [r["name"] for r in records if r["status"] == "PARTIAL"]
    PIPELINE_REPORT["closed_cap_labels"] = {
        "closed_vtp": str(CLOSED_BOOLEAN_OUTPUT_VTP),
        "facenames": str(CLOSED_BOOLEAN_OUTPUT_FACENAMES),
        "reference_cap_count": len(source_cap_ids),
        "assigned_cap_count": len(source_cap_ids) - len(missing),
        "missing_or_ambiguous_caps": missing,
        "partially_matched_caps": partial,
        "report_csv": str(report_path),
        "warning": "Labels are geometric matches, not proof of cap watertightness or CFD meshability",
    }
    if missing or partial:
        _status("closed_cap_assignment", (
            f"Created labeled closed VTP; {len(missing)} missing/ambiguous "
            f"and {len(partial)} partial cap labels. See {report_path}"), severity="warning")
    else:
        _status("closed_cap_assignment", (
            f"Created labeled closed VTP and .facenames; "
            f"{len(source_cap_ids)} cap labels matched"))
    return output_poly


