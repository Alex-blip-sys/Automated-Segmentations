def build_volume_grid(points, node_tags, tets, tet_tags) -> pv.UnstructuredGrid:
    n_tets = len(tets)

    cells = np.empty((n_tets, 5), dtype=np.int64)
    cells[:, 0] = 4
    cells[:, 1:] = tets

    celltypes = np.full(n_tets, pv.CellType.TETRA, dtype=np.uint8)

    grid = pv.UnstructuredGrid(
        cells.ravel(),
        celltypes,
        np.asarray(points, dtype=float),
    )

    grid.point_data["GlobalNodeID"] = _int32_checked(node_tags, "GlobalNodeID")
    grid.cell_data["GlobalElementID"] = _int32_checked(
        tet_tags,
        "GlobalElementID",
    )
    grid.cell_data["ModelRegionID"] = np.ones(n_tets, dtype=np.int32)

    return grid



def extract_boundary_faces(points, tets):
    """
    Return outward-oriented boundary triangle connectivity and owning tet rows.

    A tetra face is on the exterior exactly when its unordered node triplet
    occurs once among all tetrahedra.
    """

    # Each row is the face opposite local tet vertex 0,1,2,3 respectively.
    face_lut = np.array(
        [
            [1, 2, 3],
            [0, 2, 3],
            [0, 1, 3],
            [0, 1, 2],
        ],
        dtype=np.int64,
    )

    all_faces = tets[:, face_lut].reshape(-1, 3)
    sorted_faces = np.sort(all_faces, axis=1)

    _, first_idx, counts = np.unique(
        sorted_faces,
        axis=0,
        return_index=True,
        return_counts=True,
    )

    boundary_flat_idx = first_idx[counts == 1]
    boundary_faces = all_faces[boundary_flat_idx].copy()
    owner_tet_rows = boundary_flat_idx // 4
    opposite_slots = boundary_flat_idx % 4
    opposite_nodes = tets[owner_tet_rows, opposite_slots]

    # Orient each triangle away from its owning tetrahedron interior.
    p0 = points[boundary_faces[:, 0]]
    p1 = points[boundary_faces[:, 1]]
    p2 = points[boundary_faces[:, 2]]
    popp = points[opposite_nodes]

    normals = np.cross(p1 - p0, p2 - p0)
    to_inside = popp - p0
    points_inward = np.einsum("ij,ij->i", normals, to_inside) > 0.0

    if np.any(points_inward):
        tmp = boundary_faces[points_inward, 1].copy()
        boundary_faces[points_inward, 1] = boundary_faces[points_inward, 2]
        boundary_faces[points_inward, 2] = tmp

    return boundary_faces, owner_tet_rows



def transfer_model_face_ids(
    labelled_surface: pv.PolyData,
    points: np.ndarray,
    boundary_faces: np.ndarray,
) -> np.ndarray:
    """Transfer ModelFaceID to Gmsh boundary triangles by nearest surface cell."""

    if "ModelFaceID" not in labelled_surface.cell_data:
        raise RuntimeError("Labelled input surface has no ModelFaceID array.")

    centroids = points[boundary_faces].mean(axis=1)

    # PyVista delegates this to a VTK cell locator and supports batched points.
    try:
        closest_ids, closest_points = labelled_surface.find_closest_cell(
            centroids,
            return_closest_point=True,
        )
        closest_ids = np.asarray(closest_ids, dtype=np.int64)
        closest_points = np.asarray(closest_points, dtype=float)
        distances = np.linalg.norm(centroids - closest_points, axis=1)
    except TypeError:
        # Compatibility with older PyVista releases.
        closest_ids = np.asarray(
            labelled_surface.find_closest_cell(centroids),
            dtype=np.int64,
        )
        distances = None

    source_face_ids = np.asarray(
        labelled_surface.cell_data["ModelFaceID"],
        dtype=np.int32,
    )
    model_face_ids = source_face_ids[closest_ids]

    if distances is not None and len(distances):
        bounds = labelled_surface.bounds
        diag = math.sqrt(
            (bounds[1] - bounds[0]) ** 2
            + (bounds[3] - bounds[2]) ** 2
            + (bounds[5] - bounds[4]) ** 2
        )
        warn_dist = diag * FACE_TRANSFER_WARN_FRACTION_OF_BBOX
        max_dist = float(distances.max())
        n_far = int(np.count_nonzero(distances > warn_dist))

        print(f"  Max boundary->source transfer distance: {max_dist:.6g}")
        if n_far:
            print(
                f"  WARNING: {n_far} boundary triangles are farther than "
                f"{warn_dist:.6g} from the labelled source surface."
            )

    return model_face_ids.astype(np.int32, copy=False)



def make_boundary_polydata(
    points,
    global_node_ids,
    faces,
    owner_global_element_ids,
    model_face_ids,
    mask=None,
) -> pv.PolyData:
    """Create a compact VTP surface while preserving volume GlobalNodeID."""

    if mask is not None:
        mask = np.asarray(mask, dtype=bool)
        faces = faces[mask]
        owner_global_element_ids = owner_global_element_ids[mask]
        model_face_ids = model_face_ids[mask]

    if len(faces) == 0:
        return pv.PolyData()

    unique_rows, inverse = np.unique(faces.ravel(), return_inverse=True)
    local_faces = inverse.reshape(-1, 3)

    vtk_faces = np.empty((len(local_faces), 4), dtype=np.int64)
    vtk_faces[:, 0] = 3
    vtk_faces[:, 1:] = local_faces

    poly = pv.PolyData(
        points[unique_rows],
        vtk_faces.ravel(),
    )

    poly.point_data["GlobalNodeID"] = _int32_checked(
        global_node_ids[unique_rows],
        "surface GlobalNodeID",
    )
    poly.cell_data["GlobalElementID"] = _int32_checked(
        owner_global_element_ids,
        "surface GlobalElementID",
    )
    poly.cell_data["ModelFaceID"] = np.asarray(
        model_face_ids,
        dtype=np.int32,
    )

    return poly



def safe_face_filename(name: str, fid: int) -> str:
    clean = re.sub(r"[^A-Za-z0-9_.-]+", "_", name.strip())
    clean = clean.strip("._")
    if not clean:
        clean = f"face_{fid}"
    return clean + ".vtp"



def write_mesh_complete(
    mesh_complete_dir: str,
    volume_grid: pv.UnstructuredGrid,
    labelled_surface: pv.PolyData,
    assignments: dict[int, str],
    points: np.ndarray,
    node_tags: np.ndarray,
    tets: np.ndarray,
    tet_tags: np.ndarray,
):
    outdir = Path(mesh_complete_dir)
    face_dir = outdir / "mesh-surfaces"

    outdir.mkdir(parents=True, exist_ok=True)
    if face_dir.exists():
        shutil.rmtree(face_dir)
    face_dir.mkdir(parents=True, exist_ok=True)

    print("\nExtracting tetrahedral exterior surface...")
    boundary_faces, owner_rows = extract_boundary_faces(points, tets)
    owner_element_ids = tet_tags[owner_rows]

    print(f"  Boundary triangles: {len(boundary_faces)}")

    print("Transferring ModelFaceID onto Gmsh boundary triangles...")
    boundary_face_ids = transfer_model_face_ids(
        labelled_surface,
        points,
        boundary_faces,
    )

    unknown = sorted(set(np.unique(boundary_face_ids)) - set(assignments.keys()))
    if unknown:
        raise RuntimeError(
            "Boundary transfer produced ModelFaceID values not present in "
            f"the assignments map: {unknown}"
        )

    exterior = make_boundary_polydata(
        points,
        node_tags,
        boundary_faces,
        owner_element_ids,
        boundary_face_ids,
    )

    volume_path = outdir / "mesh-complete.mesh.vtu"
    exterior_path = outdir / "mesh-complete.exterior.vtp"
    walls_path = outdir / "walls_combined.vtp"

    volume_grid.save(str(volume_path))
    exterior.save(str(exterior_path))

    print("\nWriting mesh-surfaces...")

    used_names = set()
    wall_mask_total = np.zeros(len(boundary_faces), dtype=bool)

    for fid in sorted(assignments):
        name = assignments[fid]
        mask = boundary_face_ids == int(fid)
        n_cells = int(np.count_nonzero(mask))

        if n_cells == 0:
            print(f"  WARNING: face '{name}' (fid={fid}) has zero Gmsh boundary cells")
            continue

        filename = safe_face_filename(name, fid)
        stem = Path(filename).stem
        suffix = Path(filename).suffix

        if filename.lower() in used_names:
            filename = f"{stem}_fid{fid}{suffix}"
        used_names.add(filename.lower())

        face_poly = make_boundary_polydata(
            points,
            node_tags,
            boundary_faces,
            owner_element_ids,
            boundary_face_ids,
            mask,
        )
        face_poly.save(str(face_dir / filename))

        if "wall" in name.lower():
            wall_mask_total |= mask

        print(f"  {filename:<40} fid={fid:<5} cells={n_cells}")

    if not np.any(wall_mask_total):
        raise RuntimeError(
            "No wall-labelled boundary triangles were produced; cannot write "
            "walls_combined.vtp."
        )

    walls = make_boundary_polydata(
        points,
        node_tags,
        boundary_faces,
        owner_element_ids,
        boundary_face_ids,
        wall_mask_total,
    )
    walls.save(str(walls_path))

    # Final consistency checks that matter for SimVascular.
    volume_global_nodes = set(
        np.asarray(volume_grid.point_data["GlobalNodeID"], dtype=np.int64).tolist()
    )
    exterior_global_nodes = set(
        np.asarray(exterior.point_data["GlobalNodeID"], dtype=np.int64).tolist()
    )

    missing_nodes = exterior_global_nodes - volume_global_nodes
    if missing_nodes:
        raise RuntimeError(
            f"Exterior mesh references {len(missing_nodes)} GlobalNodeID values "
            "not present in the volume mesh."
        )

    print("\nSimVascular mesh-complete written successfully:")
    print(f"  {outdir}")
    print(f"  Volume nodes      : {volume_grid.n_points}")
    print(f"  Volume tetrahedra : {volume_grid.n_cells}")
    print(f"  Exterior triangles: {exterior.n_cells}")
    print(f"  Face files        : {len(list(face_dir.glob('*.vtp')))}")


