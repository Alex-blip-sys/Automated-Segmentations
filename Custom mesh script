def _int32_checked(values: np.ndarray, name: str) -> np.ndarray:
    values = np.asarray(values, dtype=np.int64)
    info = np.iinfo(np.int32)
    if values.size and (values.min() < info.min or values.max() > info.max):
        raise RuntimeError(f"{name} values exceed signed Int32 range.")
    return values.astype(np.int32)



def _gmsh_count_elements(dim: int) -> int:
    """Return the number of mesh elements currently classified in dimension dim."""
    element_types, element_tag_blocks, _ = gmsh.model.mesh.getElements(dim)
    return int(sum(len(tags) for tags in element_tag_blocks))



def _configure_gmsh_mesh_options(*, preserve_surface: bool) -> None:
    """Set common Gmsh mesh options for one meshing attempt."""

    gmsh.option.setNumber("Mesh.Algorithm3D", float(GMSH_ALGORITHM_3D))
    gmsh.option.setNumber("Mesh.ElementOrder", 1)
    gmsh.option.setNumber("Mesh.SaveAll", 1)

    # This is the key preserve-surface option.  In preserve mode the imported
    # STL already contains the desired 2-D boundary mesh, so only the new 3-D
    # discrete volume should be meshed.
    gmsh.option.setNumber(
        "Mesh.MeshOnlyEmpty",
        1 if (preserve_surface and GMSH_PRESERVE_MESH_ONLY_EMPTY) else 0,
    )

    if GMSH_MIN_SIZE is not None:
        gmsh.option.setNumber("Mesh.MeshSizeMin", float(GMSH_MIN_SIZE))
    if GMSH_MAX_SIZE is not None:
        gmsh.option.setNumber("Mesh.MeshSizeMax", float(GMSH_MAX_SIZE))



def _prepare_preserved_stl_volume(stl_path: str):
    """
    Import the STL exactly as a discrete surface mesh and create a discrete
    volume whose boundary is the imported surface entity/entities.

    No classifySurfaces() and no createGeometry() are called here.  This means
    Gmsh never has to construct a 2-D parametrization of the pulmonary surface.
    """

    gmsh.model.add("pulmonary_artery_preserved_surface")
    gmsh.merge(stl_path)

    surface_tags = [tag for dim, tag in gmsh.model.getEntities(2)]
    if not surface_tags:
        raise RuntimeError("Gmsh imported no discrete surface entities from the STL.")

    surface_elements_before = _gmsh_count_elements(2)
    if surface_elements_before <= 0:
        raise RuntimeError("The imported STL contains no 2-D surface elements.")

    # IMPORTANT: the imported STL surface is a DISCRETE 2-D entity, but the
    # enclosing 3-D region should be created with Gmsh's built-in GEO kernel.
    # Gmsh explicitly supports these hybrid models: a built-in CAD volume may
    # use discrete surface entities on its boundary.  Creating a *discrete*
    # volume here is not sufficient for Gmsh to generate tetrahedra; it can
    # leave us with a model containing only the original STL triangles.
    #
    # We therefore make a built-in surface loop from the existing discrete
    # surface(s), create a built-in volume, and synchronize.  MeshOnlyEmpty=1
    # below keeps the existing STL triangles and asks Gmsh to mesh only the
    # previously empty 3-D volume.
    surface_loop = gmsh.model.geo.addSurfaceLoop(surface_tags)
    volume_tag = gmsh.model.geo.addVolume([surface_loop])
    gmsh.model.geo.synchronize()

    # Sanity check: after synchronize there must be a true 3-D model entity.
    volume_entities = gmsh.model.getEntities(3)
    if not volume_entities:
        raise RuntimeError(
            "Failed to create a 3-D hybrid Gmsh volume from the preserved STL shell."
        )

    pg = gmsh.model.addPhysicalGroup(3, [volume_tag])
    gmsh.model.setPhysicalName(3, pg, "fluid")

    _configure_gmsh_mesh_options(preserve_surface=True)

    print("\nGmsh preserve-surface attempt")
    print(f"  Imported surface entities : {len(surface_tags)}")
    print(f"  Existing surface elements : {surface_elements_before}")
    print("  Surface reparametrization : DISABLED")
    print("  Mesh existing 2-D faces   : NO")
    print("  Tetrahedralizing enclosed volume...")

    gmsh.model.mesh.generate(3)
    gmsh.model.mesh.setOrder(1)

    # Do not declare preserve-mode success unless Gmsh actually produced
    # 3-D elements.  This catches the exact failure mode where meshing returns
    # without an exception but the model still contains only surface triangles.
    volume_elements_after = _gmsh_count_elements(3)
    if volume_elements_after <= 0:
        raise RuntimeError(
            "Preserved STL shell was accepted, but Gmsh generated zero 3-D "
            "elements. The hybrid volume was not tetrahedralized."
        )

    print(f"  3-D elements generated     : {volume_elements_after}")

    surface_elements_after = _gmsh_count_elements(2)
    if surface_elements_after != surface_elements_before:
        print(
            "  WARNING: 2-D surface element count changed from "
            f"{surface_elements_before} to {surface_elements_after}."
        )
    else:
        print("  Existing STL surface mesh was preserved.")

    return volume_tag



def _prepare_reparameterized_stl_volume(stl_path: str):
    """Older Gmsh STL workflow retained as an optional fallback."""

    gmsh.model.add("pulmonary_artery_reparameterized_surface")
    gmsh.merge(stl_path)

    angle = math.radians(GMSH_CLASSIFY_ANGLE_DEG)

    print("\nGmsh reparametrization fallback")
    print("  Running classifySurfaces()/createGeometry()...")

    gmsh.model.mesh.classifySurfaces(
        angle,
        True,   # create boundary curves if needed
        True,   # split enough for reparametrization
        math.pi,
    )
    gmsh.model.mesh.createGeometry()

    surface_tags = [tag for dim, tag in gmsh.model.getEntities(2)]
    if not surface_tags:
        raise RuntimeError("Gmsh created no discrete surface entities.")

    surface_loop = gmsh.model.geo.addSurfaceLoop(surface_tags)
    volume_tag = gmsh.model.geo.addVolume([surface_loop])
    gmsh.model.geo.synchronize()

    pg = gmsh.model.addPhysicalGroup(3, [volume_tag])
    gmsh.model.setPhysicalName(3, pg, "fluid")

    _configure_gmsh_mesh_options(preserve_surface=False)

    print(f"  Reparameterized surface entities: {len(surface_tags)}")
    print("  Tetrahedralizing enclosed volume...")

    gmsh.model.mesh.generate(3)
    gmsh.model.mesh.setOrder(1)

    return volume_tag



def run_gmsh(stl_path: str, msh_path: str):
    """
    Create a first-order tetrahedral mesh from the closed STL surface.

    By default the existing STL triangles are preserved and Gmsh is asked only
    to fill the empty 3-D volume.  The original surface-reparametrization route
    can be used as a fallback or selected explicitly in the settings above.
    """

    valid_strategies = {
        "preserve_first",
        "preserve_only",
        "reparameterize",
    }

    strategy = str(GMSH_SURFACE_STRATEGY).strip().lower()
    if strategy not in valid_strategies:
        raise ValueError(
            "GMSH_SURFACE_STRATEGY must be one of: "
            + ", ".join(sorted(valid_strategies))
        )

    if strategy == "preserve_only":
        attempts = ["preserve"]
    elif strategy == "reparameterize":
        attempts = ["reparameterize"]
    else:
        attempts = ["preserve"]
        if GMSH_ALLOW_REPARAMETERIZATION_FALLBACK:
            attempts.append("reparameterize")

    gmsh.initialize()

    try:
        gmsh.option.setNumber("General.Terminal", 1 if GMSH_TERMINAL_OUTPUT else 0)

        failures = []
        successful_mode = None

        for attempt_number, mode in enumerate(attempts, start=1):
            # A failed Gmsh meshing attempt can leave partial entities/elements in
            # the model.  Start every strategy with a completely clean model.
            gmsh.clear()

            try:
                if mode == "preserve":
                    _prepare_preserved_stl_volume(stl_path)
                else:
                    _prepare_reparameterized_stl_volume(stl_path)

                successful_mode = mode
                break

            except Exception as exc:
                failures.append((mode, str(exc)))

                print("")
                print("=" * 72)
                print(f"GMSH {mode.upper()} ATTEMPT FAILED")
                print("=" * 72)
                print(str(exc))

                if attempt_number < len(attempts):
                    print("\nTrying the configured fallback strategy...")

        if successful_mode is None:
            details = "\n".join(
                f"  {mode}: {message}"
                for mode, message in failures
            )
            raise RuntimeError(
                "All configured Gmsh meshing strategies failed:\n" + details
            )

        print("")
        print("=" * 72)
        print("GMSH VOLUME MESH CREATED")
        print("=" * 72)
        print(f"Successful surface strategy: {successful_mode}")

        if GMSH_OPTIMIZE_NETGEN:
            print("Optimizing tetrahedra with Netgen optimizer...")
            try:
                gmsh.model.mesh.optimize("Netgen")
            except Exception as exc:
                print(f"  WARNING: Netgen optimization failed: {exc}")

        if KEEP_GMSH_MSH:
            gmsh.write(msh_path)

        # ----------------------------
        # Nodes
        # ----------------------------
        node_tags, coords, _ = gmsh.model.mesh.getNodes()
        node_tags = np.asarray(node_tags, dtype=np.int64)
        points = np.asarray(coords, dtype=float).reshape(-1, 3)

        if len(node_tags) != len(points):
            raise RuntimeError("Unexpected mismatch in Gmsh node arrays.")

        # Fast tag -> row lookup. Gmsh tags are positive integers.
        max_node_tag = int(node_tags.max()) if len(node_tags) else 0
        tag_to_row = np.full(max_node_tag + 1, -1, dtype=np.int64)
        tag_to_row[node_tags] = np.arange(len(node_tags), dtype=np.int64)

        # ----------------------------
        # 3D elements
        # ----------------------------
        element_types, element_tag_blocks, node_tag_blocks = (
            gmsh.model.mesh.getElements(3)
        )

        tet_connectivity = []
        tet_element_tags = []
        unsupported = []

        for etype, etags, enodes in zip(
            element_types,
            element_tag_blocks,
            node_tag_blocks,
        ):
            etype = int(etype)
            etags = np.asarray(etags, dtype=np.int64)
            enodes = np.asarray(enodes, dtype=np.int64)

            name, dim, order, n_nodes, _, n_primary = (
                gmsh.model.mesh.getElementProperties(etype)
            )

            # Gmsh type 4 = 4-node first-order tetrahedron.
            if etype != 4 or int(n_nodes) != 4 or int(order) != 1:
                unsupported.append(
                    (etype, str(name), len(etags), int(n_nodes), int(order))
                )
                continue

            conn_tags = enodes.reshape(-1, 4)

            if conn_tags.max(initial=0) > max_node_tag:
                raise RuntimeError("A tetrahedron references an unknown Gmsh node tag.")

            conn_rows = tag_to_row[conn_tags]
            if np.any(conn_rows < 0):
                raise RuntimeError("Could not map all tetrahedral node tags to coordinates.")

            tet_connectivity.append(conn_rows)
            tet_element_tags.append(etags)

        if unsupported:
            details = "; ".join(
                f"type {t[0]} ({t[1]}): {t[2]} elements"
                for t in unsupported
            )
            raise RuntimeError(
                "Gmsh generated unsupported 3D element types. This exporter "
                f"expects only first-order tetrahedra. Found: {details}"
            )

        if not tet_connectivity:
            raise RuntimeError("Gmsh generated no tetrahedra.")

        tets = np.vstack(tet_connectivity).astype(np.int64, copy=False)
        tet_tags = np.concatenate(tet_element_tags).astype(np.int64, copy=False)

        print(f"  Gmsh nodes       : {len(points)}")
        print(f"  Gmsh tetrahedra  : {len(tets)}")

        return points, node_tags, tets, tet_tags

    finally:
        gmsh.finalize()


