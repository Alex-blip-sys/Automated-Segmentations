# Percentile used to estimate cap radius from reference cap points.
CAP_PERCENTILE = 95

# Thickness of the cap-plane envelope used ONLY for assigning ModelFaceID to
# RESULT_VTP before meshing.  Increase if a known planar cap gets zero cells.
PLANE_TOL_FACTOR = 0.00005

# Small enlargement of the radial cap envelope during initial face assignment.
