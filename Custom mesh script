# INITIAL SIMVASCULAR FACE ASSIGNMENT
# ============================================================================


def extract_cap_info(
    surface: pv.PolyData,
    facename_file: str,
    percentile: float = 95,
):
    """Extract planar cap descriptors from all non-wall reference faces."""

    face_map = read_facenames(facename_file)

    cap_entries = {
        fid: name
        for fid, name in face_map.items()
        if "wall" not in name.lower()
    }

    wall_entries = {
        fid: name
        for fid, name in face_map.items()
        if "wall" in name.lower()
    }

    if not cap_entries:
        raise RuntimeError("No non-wall faces found in .facenames file.")

    if "ModelFaceID" not in surface.cell_data:
        raise RuntimeError("ModelFaceID cell data missing from BASE_VTP.")

    mf_ids = np.asarray(surface.cell_data["ModelFaceID"]).astype(np.int64)
    caps = []

    for fid, name in sorted(cap_entries.items()):
        cell_ids = np.where(mf_ids == fid)[0]

        if len(cell_ids) == 0:
            print(f"  WARNING: cap '{name}' (fid={fid}) has no cells; skipping")
            continue

        sub = surface.extract_cells(cell_ids).extract_surface()
        pts = np.asarray(sub.points, dtype=float)

        centroid = pts.mean(axis=0)
        centered = pts - centroid

        _, _, vh = np.linalg.svd(centered, full_matrices=False)
        normal = vh[-1]
        normal /= np.linalg.norm(normal)

        vec = pts - centroid
        signed_plane = vec @ normal
        projected = vec - np.outer(signed_plane, normal)
        radial_dist = np.linalg.norm(projected, axis=1)

        radius = float(np.percentile(radial_dist, percentile))
        plane_tol = max(radius * PLANE_TOL_FACTOR, 1.0e-12)

        caps.append(
            {
                "fid": int(fid),
                "name": str(name),
                "centroid": centroid,
                "normal": normal,
                "radius": radius,
                "plane_tol": plane_tol,
            }
        )

        print(
            f"  Cap '{name}' | fid={fid} | "
            f"radius={radius:.6g} | plane_tol={plane_tol:.6g}"
        )

    # If the reference contains exactly one wall ID, preserve it.  Otherwise
    # combine all unassigned result cells into one wall face.
    if len(wall_entries) == 1:
        wall_fid, wall_name = next(iter(wall_entries.items()))
    else:
        wall_fid = max(face_map.keys()) + 1
        wall_name = "wall"
        if len(wall_entries) > 1:
            print(
                "  WARNING: multiple wall names found in the reference. "
                "RESULT_VTP will use one combined wall face."
            )

    return caps, int(wall_fid), str(wall_name)



def assign_face_ids(
    result_mesh: pv.PolyData,
    caps,
    wall_fid: int,
    wall_name: str,
):
    """Stamp ModelFaceID onto RESULT_VTP using reference cap geometry."""

    tri = result_mesh.triangulate()
    faces = tri.faces.reshape(-1, 4)[:, 1:]
    pts = np.asarray(tri.points, dtype=float)
    cell_centroids = pts[faces].mean(axis=1)

    face_id_array = np.zeros(tri.n_cells, dtype=np.int32)
    best_score = np.full(tri.n_cells, np.inf, dtype=float)

    for cap in caps:
        centroid = cap["centroid"]
        normal = cap["normal"]
        radius = cap["radius"]
        plane_tol = cap["plane_tol"]

        vec = cell_centroids - centroid
        signed = vec @ normal
        plane_dist = np.abs(signed)
        projected = vec - np.outer(signed, normal)
        radial_dist = np.linalg.norm(projected, axis=1)

        radial_limit = radius * CAP_RADIUS_ASSIGNMENT_FACTOR
        mask = (plane_dist <= plane_tol) & (radial_dist <= radial_limit)

        # Resolve rare overlaps deterministically by normalized distance.
        score = (
            plane_dist / max(plane_tol, 1.0e-15)
            + radial_dist / max(radius, 1.0e-15)
        )
        update = mask & (score < best_score)
        face_id_array[update] = int(cap["fid"])
        best_score[update] = score[update]

        n_assigned = int(np.count_nonzero(update))
        status = "OK" if np.count_nonzero(mask) > 0 else "ZERO CELLS"
        print(f"  Cap '{cap['name']}' -> {n_assigned} cells ({status})")

    wall_mask = face_id_array == 0
    face_id_array[wall_mask] = wall_fid
    print(f"  Wall '{wall_name}' (fid={wall_fid}) -> {wall_mask.sum()} cells")

    tri.cell_data["ModelFaceID"] = face_id_array

    assignments = {int(c["fid"]): str(c["name"]) for c in caps}
    assignments[int(wall_fid)] = wall_name

    return tri, assignments


