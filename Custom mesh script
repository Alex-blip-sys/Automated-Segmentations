def read_facenames(fname: str) -> dict[int, str]:
    faces = {}
    pattern = re.compile(r"set\s+gPolyDataFaceNames\((\d+)\)\s+(\S+)")

    with open(fname, "r") as f:
        for line in f:
            m = pattern.match(line.strip())
            if m:
                fid = int(m.group(1))
                name = m.group(2).strip().strip("{}")
                faces[fid] = name

    return faces



def write_facenames(path: str, assignments: dict[int, str]) -> None:
    with open(path, "w") as f:
        f.write("global gPolyDataFaceNames\n\n")
        for fid in sorted(assignments):
            f.write(f"set gPolyDataFaceNames({fid}) {assignments[fid]}\n")



def load_surface(path: str) -> pv.PolyData:
    mesh = pv.read(path)
    if not isinstance(mesh, pv.PolyData):
        mesh = mesh.extract_surface()

    mesh = mesh.triangulate()

    # PyVista signatures have varied slightly between releases.
    try:
        mesh = mesh.clean(
            point_merging=True,
            tolerance=SURFACE_CLEAN_TOLERANCE,
            absolute=True,
        )
    except TypeError:
        mesh = mesh.clean(
            point_merging=True,
            tolerance=SURFACE_CLEAN_TOLERANCE,
        )

    return mesh


