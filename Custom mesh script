def main():
    print("=" * 72)
    print("CAP ASSIGNMENT -> GMSH -> SIMVASCULAR MESH-COMPLETE")
    print("=" * 72)

    for path_name, path in (
        ("BASE_VTP", BASE_VTP),
        ("OLD_FACENAMES", OLD_FACENAMES),
        ("RESULT_VTP", RESULT_VTP),
    ):
        if not os.path.exists(path):
            raise FileNotFoundError(f"{path_name} does not exist: {path}")

    output_parent = Path(MESH_COMPLETE_DIR)
    output_parent.mkdir(parents=True, exist_ok=True)

    print("\nLoading surfaces...")
    base = load_surface(BASE_VTP)
    result = load_surface(RESULT_VTP)
    print(f"  Base   : {base.n_points} points | {base.n_cells} triangles")
    print(f"  Result : {result.n_points} points | {result.n_cells} triangles")

    print("\nExtracting reference cap geometry...")
    caps, wall_fid, wall_name = extract_cap_info(
        base,
        OLD_FACENAMES,
        percentile=CAP_PERCENTILE,
    )
    print(f"  Detected caps: {len(caps)}")

    print("\nAssigning ModelFaceID to RESULT_VTP...")
    labelled, assignments = assign_face_ids(
        result,
        caps,
        wall_fid,
        wall_name,
    )

    labelled.save(OUTPUT_VTP)
    write_facenames(OUTPUT_FACENAMES, assignments)
    print(f"  Labelled surface: {OUTPUT_VTP}")
    print(f"  Facenames       : {OUTPUT_FACENAMES}")

    if DIAGNOSTICS_ENABLED:
        diagnostic_report = run_surface_diagnostics(
            labelled, assignments, caps, wall_fid, output_parent
        )
        if (DIAG_ABORT_ON_CONFIRMED_INTERSECTIONS
                and diagnostic_report['intersection_analysis'].get('confirmed_intersecting_pairs_found', 0)):
            raise RuntimeError(
                'Confirmed self-intersections were found; inspect surface_diagnostics first.'
            )

    if DIAGNOSTICS_ONLY:
        print('\nDIAGNOSTICS_ONLY=True: report written; Gmsh volume meshing skipped.')
        return

    validate_closed_surface(labelled)

    # Orient normals for a closed surface before STL export.  Gmsh generally
    # handles STL orientation well, but consistent normals reduce ambiguity.
    try:
        gmsh_surface = labelled.compute_normals(
            cell_normals=True,
            point_normals=False,
            split_vertices=False,
            consistent_normals=True,
            auto_orient_normals=True,
            inplace=False,
        )
    except TypeError:
        gmsh_surface = labelled.compute_normals(
            cell_normals=True,
            point_normals=False,
            consistent_normals=True,
            auto_orient_normals=True,
            inplace=False,
        )

    stl_path = str(output_parent / GMSH_STL_NAME)
    msh_path = str(output_parent / GMSH_MSH_NAME)

    print(f"\nWriting temporary Gmsh surface: {stl_path}")
    gmsh_surface.save(stl_path)

    try:
        points, node_tags, tets, tet_tags = run_gmsh(
            stl_path,
            msh_path,
        )
    except Exception as exc:
        if DIAGNOSTICS_ENABLED:
            diag_dir = output_parent / DIAGNOSTICS_FOLDER
            # Save the exact Gmsh exception with the spatial QA report.
            report_path = diag_dir / 'diagnostic_report.json'
            if report_path.exists():
                try:
                    report_data = json.loads(report_path.read_text(encoding='utf-8'))
                    report_data['gmsh_failure'] = str(exc)
                    report_path.write_text(json.dumps(report_data,indent=2),encoding='utf-8')
                except Exception as log_exc:
                    print('  Could not append Gmsh error to diagnostic report:', log_exc)
            print('\n' + '=' * 72)
            print('GMSH FAILED — GEOMETRY DIAGNOSTICS ARE AVAILABLE')
            print('=' * 72)
            print('  Error:', exc)
            print('  Spatial clusters + face names:', diag_dir / 'problem_regions.csv')
            print('  Highlight problem triangles:', diag_dir / 'suspect_triangles.vtp')
            print('  Jump to problem coordinates:', diag_dir / 'problem_region_centers.vtp')
            print('  Inspect region_####_context.stl alongside the full original in Meshmixer.')
            print('  IMPORTANT: reported regions are candidate defects, not a ')
            print('  Gmsh-confirmed PLC failure coordinate.')
        raise

    print("\nBuilding SimVascular volume mesh arrays...")
    volume_grid = build_volume_grid(
        points,
        node_tags,
        tets,
        tet_tags,
    )

    write_mesh_complete(
        MESH_COMPLETE_DIR,
        volume_grid,
        labelled,
        assignments,
        points,
        node_tags,
        tets,
        tet_tags,
    )

    if not KEEP_GMSH_STL:
        try:
            os.remove(stl_path)
        except OSError:
            pass

    print("\nFinal face assignments:")
    for fid in sorted(assignments):
        print(f"  ModelFaceID={fid:<5} -> {assignments[fid]}")

    print("\nDONE")
    print(
        f"  {MESH_COMPLETE_DIR}"
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("\nERROR:")
        print(exc)
        raise
